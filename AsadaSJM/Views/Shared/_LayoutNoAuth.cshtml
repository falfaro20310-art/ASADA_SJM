@{
    ViewData["Title"] = "ASADA San José de la Montaña";

    var informacionContacto =
        ViewBag.InformacionContacto as AsadaSJM.Models.InformacionInstitucional;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/portal.css" asp-append-version="true"/>
</head>
<body>
    <!-- HEADER -->
    <nav class="navbar navbar-expand-lg navbar-asada">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                <i class="bi bi-droplet-fill" style="font-size:26px;color:var(--azul-agua);"></i>
                <span class="brand">ASADA<small>San José de la Montaña</small></span>
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end"
                 id="navMenu">

                <ul class="navbar-nav gap-lg-3">

                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Portal" asp-action="Index">
                            Inicio
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#institucional">
                            Nuestra ASADA
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            Transparencia
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            Servicios
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            Ambiente y Comunidad
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Galeria" asp-action="Index">
                            Galería
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#contacto">
                            Contacto
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="nav-link">
                            Ingresar
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <body class="@ViewData["BodyClass"]">
        @RenderBody()
    </body>

    <!-- FOOTER -->
    <footer id="contacto">

        <div class="container">

            <div class="row g-4">

                <div class="col-md-3">

                    <div class="d-flex align-items-center gap-2 mb-2">

                        <i class="bi bi-droplet-fill"
                           style="font-size:22px;"></i>

                        <strong>
                            ASADA<br>
                            <small style="font-weight:400;">
                                San José de la Montaña
                            </small>
                        </strong>

                    </div>

                    <p style="font-size:13px;">
                        Transparencia, servicio y compromiso con el agua.
                    </p>

                </div>


                <!-- CONTACTO -->
                <div class="col-md-3">

                    <h3>Contacto</h3>

                    @if (informacionContacto != null)
                    {
                        @if (!string.IsNullOrWhiteSpace(informacionContacto.Telefono))
                        {
                            <p class="mb-1">
                                <i class="bi bi-telephone-fill me-1"></i>
                                @informacionContacto.Telefono
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(informacionContacto.Correo))
                        {
                            <p class="mb-1">
                                <i class="bi bi-envelope-fill me-1"></i>
                                @informacionContacto.Correo
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(informacionContacto.Direccion))
                        {
                            <p class="mb-0">
                                <i class="bi bi-geo-alt-fill me-1"></i>
                                @informacionContacto.Direccion
                            </p>
                        }
                    }
                    else
                    {
                        <p class="mb-0">
                            Información de contacto no disponible.
                        </p>
                    }

                </div>


                <!-- HORARIO -->
                <div class="col-md-3">

                    <h3>Horario de atención</h3>

                    @if (informacionContacto != null &&
                         !string.IsNullOrWhiteSpace(informacionContacto.Horario))
                    {
                        <p class="mb-0">
                            @informacionContacto.Horario
                        </p>
                    }
                    else
                    {
                        <p class="mb-0">
                            Horario no disponible.
                        </p>
                    }

                </div>


                <div class="col-md-3">

                    <h3>Enlaces rápidos</h3>

                    <p class="mb-1">

                        <a asp-controller="Recibos"
                           asp-action="Index">
                            Consultar recibos
                        </a>

                    </p>

                    <p class="mb-1">

                        <a asp-controller="Averias"
                           asp-action="Index">
                            Reportar avería
                        </a>

                    </p>

                    <p class="mb-0">

                        <a href="#">
                            Reglamentos y tarifas
                        </a>

                    </p>

                </div>


            </div>

        </div>

    </footer>


    <div class="footer-bottom text-center">
        © 2026 ASADA San José de la Montaña. Todos los derechos reservados.
    </div>
</body>
</html>
