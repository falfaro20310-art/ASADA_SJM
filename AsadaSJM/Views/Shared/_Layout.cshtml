
@{
    bool autenticado =
        User.Identity?.IsAuthenticated ?? false;

    bool esAdministrador =
        User.IsInRole("Administrador");

    bool esAbonado =
        User.IsInRole("Abonado");

    bool esOperativo =
        User.IsInRole("Operativo");

    string controladorActual =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    bool esGestionAmbiental =
        controladorActual == "GestionAmbiental" ||
        controladorActual == "ComunidadAmbiental";

    string nombreUsuario =
        User.Identity?.Name ?? "";

    string rolActual =
        esAdministrador ? "Administrador" :
        esOperativo ? "Operativo" :
        esAbonado ? "Abonado" :
        "";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Sistema Web ASADA SJM
    </title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Roboto:wght@400;500&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/portal.css"
          asp-append-version="true" />
</head>

<body>

    <nav class="sidebar">

        <div class="brand">
            <i class="bi bi-droplet-fill"></i>
            ASADA SJM
        </div>

        <div class="nav flex-column">

            @* MENÚ DEL ADMINISTRADOR *@

            @if (esAdministrador)
            {
                <a class="nav-link @(controladorActual == "Home" ? "active" : "")"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-house-fill"></i>
                    Inicio
                </a>

                <a class="nav-link @(controladorActual == "Abonados" ? "active" : "")"
                   asp-controller="Abonados"
                   asp-action="Index">

                    <i class="bi bi-people-fill"></i>
                    Abonados
                </a>

                <a class="nav-link @(controladorActual == "Averias" ? "active" : "")"
                   asp-controller="Averias"
                   asp-action="Index">

                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Averías
                </a>

                <a class="nav-link @(controladorActual == "Tramites" ? "active" : "")"
                   asp-controller="Tramites"
                   asp-action="Index">

                    <i class="bi bi-file-earmark-text-fill"></i>
                    Trámites
                </a>

                <a class="nav-link @(controladorActual == "Documentos" ? "active" : "")"
                   asp-controller="Documentos"
                   asp-action="Index">

                    <i class="bi bi-folder-fill"></i>
                    Documentos
                </a>

                <a class="nav-link @(controladorActual == "Recibos" ? "active" : "")"
                   asp-controller="Recibos"
                   asp-action="Index">

                    <i class="bi bi-receipt"></i>
                    Recibos
                </a>

                <a class="nav-link @(controladorActual == "Expresidentes" ? "active" : "")"
                   asp-controller="Expresidentes"
                   asp-action="Index">

                    <i class="bi bi-person-lines-fill"></i>
                    Presidentes
                </a>

                <a class="nav-link @(controladorActual == "Galeria" ? "active" : "")"
                   asp-controller="Galeria"
                   asp-action="Index">

                    <i class="bi bi-images"></i>
                    Galería Fotográfica
                </a>

                <a class="nav-link @(controladorActual == "Institucional" ? "active" : "")"
                   asp-controller="Institucional"
                   asp-action="Editar">

                    <i class="bi bi-info-circle-fill"></i>
                    Información institucional
                </a>

                <a class="nav-link @(esGestionAmbiental ? "active" : "")"
                   asp-controller="GestionAmbiental"
                   asp-action="Index">

                    <i class="bi bi-tree-fill"></i>
                    Gestión Ambiental
                </a>

                <a class="nav-link @(controladorActual == "Bitacora" ? "active" : "")"
                   asp-controller="Bitacora"
                   asp-action="Index">

                    <i class="bi bi-clock-history"></i>
                    Bitácora
                </a>

                <a class="nav-link @(controladorActual == "Usuarios" ? "active" : "")"
                   asp-controller="Usuarios"
                   asp-action="Index">

                    <i class="bi bi-person-badge-fill"></i>
                    Usuarios y roles
                </a>

                @* NUEVO: MPA-02 A MPA-06 *@

                <a class="nav-link @(controladorActual == "PanelAdministrativo" ? "active" : "")"
                   asp-controller="PanelAdministrativo"
                   asp-action="Index">

                    <i class="bi bi-speedometer2"></i>
                    Gestión del panel
                </a>

                <hr class="mx-3" />

                <a class="nav-link"
                   asp-controller="Account"
                   asp-action="Logout">

                    <i class="bi bi-box-arrow-right"></i>
                    Cerrar sesión
                </a>
            }

            @* MENÚ DE ABONADOS Y OPERATIVOS *@

            else if (autenticado)
            {
                <a class="nav-link"
                   asp-controller="Portal"
                   asp-action="Index">

                    <i class="bi bi-house-fill"></i>
                    Portal
                </a>

                <a class="nav-link @(esGestionAmbiental ? "active" : "")"
                   asp-controller="GestionAmbiental"
                   asp-action="Index">

                    <i class="bi bi-tree-fill"></i>
                    Gestión Ambiental
                </a>

                <hr class="mx-3" />

                <a class="nav-link"
                   asp-controller="Account"
                   asp-action="Logout">

                    <i class="bi bi-box-arrow-right"></i>
                    Cerrar sesión
                </a>
            }

            @* MENÚ PÚBLICO *@

            else
            {
                <a class="nav-link"
                   asp-controller="Portal"
                   asp-action="Index">

                    <i class="bi bi-house-fill"></i>
                    Inicio
                </a>

                <a class="nav-link @(esGestionAmbiental ? "active" : "")"
                   asp-controller="GestionAmbiental"
                   asp-action="Index">

                    <i class="bi bi-tree-fill"></i>
                    Gestión Ambiental
                </a>
            }

        </div>
    </nav>

    <main class="main-content">

        <div class="topbar">

            <div>

                <h1>
                    @ViewData["Title"]
                </h1>

                @if (esAdministrador)
                {
                    <div class="text-muted"
                         style="font-size:14px;">

                        Panel administrativo — ASADA San José de la Montaña

                    </div>
                }
                else if (autenticado)
                {
                    <div class="text-muted"
                         style="font-size:14px;">

                        ASADA San José de la Montaña

                    </div>
                }

            </div>

            @if (autenticado)
            {
                <div class="text-end">

                    <div class="fw-semibold">
                        @nombreUsuario
                    </div>

                    <span class="role-badge">
                        @rolActual
                    </span>

                </div>
            }
        </div>

        @RenderBody()

    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/FotoGaleriaScript.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
