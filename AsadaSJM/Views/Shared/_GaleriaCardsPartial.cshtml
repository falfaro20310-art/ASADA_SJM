@model IEnumerable<AsadaSJM.Models.GaleriaDTO>

@{
    bool isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador");

    // Quemado como prueba
    var placeholderSets = new List<(string Main, string Mini1, string Mini2, string Mini3)>()
    {
        // Set 1 (People)
        ("https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-1.2.1&auto=format&fit=crop&w=870&q=80", 
         "https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?ixlib=rb-1.2.1&auto=format&fit=crop&w=871&q=80", 
         "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-1.2.1&auto=format&fit=crop&w=848&q=80", 
         "https://images.unsplash.com/photo-1462804993656-fac4ff489837?ixlib=rb-1.2.1&auto=format&fit=crop&w=870&q=80"),
        
        // Set 2 (Nature)
        ("https://images.unsplash.com/photo-1444464666168-49d633b86797?ixlib=rb-1.2.1&auto=format&fit=crop&w=869&q=80", 
         "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?ixlib=rb-1.2.1&auto=format&fit=crop&w=870&q=80", 
         "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?ixlib=rb-1.2.1&auto=format&fit=crop&w=974&q=80", 
         "https://images.unsplash.com/photo-1472214103451-9374bd1c798e?ixlib=rb-1.2.1&auto=format&fit=crop&w=870&q=80")
    };
    int totalSets = placeholderSets.Count;
    int indexCounter = 0;
}

<div class="row g-4 col-12">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            var currentSet = placeholderSets[indexCounter % totalSets];
            indexCounter++;

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card bg-light p-3 rounded-4 shadow-sm border-0 h-100 card-galeria" style="cursor: pointer;" data-id="@item.IdGaleria">
                    
                    <!-- Imágenes quemadas -->
                    <img src="@currentSet.Main" alt="@item.Titulo" class="img-fluid rounded-3 mb-3 w-100 object-fit-cover" style="height: 180px; cursor: pointer;">

                    <div class="row g-2 mb-3">
                        <div class="col-4"><img src="@currentSet.Mini1" alt="Mini 1" class="img-fluid rounded-2 w-100 object-fit-cover" style="height: 60px; cursor: pointer;"></div>
                        <div class="col-4"><img src="@currentSet.Mini2" alt="Mini 2" class="img-fluid rounded-2 w-100 object-fit-cover" style="height: 60px; cursor: pointer;"></div>
                        <div class="col-4"><img src="@currentSet.Mini3" alt="Mini 3" class="img-fluid rounded-2 w-100 object-fit-cover" style="height: 60px; cursor: pointer;"></div>
                    </div>

                    <h2 class="h6 fw-bold text-dark mb-1" style="cursor: pointer;">@item.Titulo</h2>

                    <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 36px;">
                        @item.Descripcion
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                        <span class="d-flex align-items-center text-muted small fw-medium text-capitalize">
                            @(item.Fecha.HasValue ? item.Fecha.Value.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-ES")) : "")
                        </span>

                        @if (isAdmin)
                        {
                            <div onclick="event.stopPropagation();">
                                <a asp-action="Editar" asp-route-id="@item.IdGaleria" class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        }
                    </div>

                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p class="text-muted">No hay galerías registradas.</p>
        </div>
    }
</div>