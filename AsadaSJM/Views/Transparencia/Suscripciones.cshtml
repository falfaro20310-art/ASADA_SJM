@model AsadaSJM.Models.SuscripcionDocumentoViewModel

@{
    ViewData["Title"] = "Mis notificaciones";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h4 class="mb-1">
            Mis notificaciones
        </h4>

        <p class="text-muted mb-0">
            Seleccione las categorías de documentos sobre las que desea recibir avisos.
        </p>
    </div>

    <a asp-controller="Transparencia"
       asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Volver

    </a>

</div>


@if (TempData["MensajeSuscripcion"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["MensajeSuscripcion"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>

    </div>
}


@if (ViewBag.Error != null)
{
    <div class="alert alert-danger"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @ViewBag.Error

    </div>
}


<div class="panel">

    <form asp-controller="Transparencia"
          asp-action="Suscripciones"
          method="post">

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All"
                 class="alert alert-danger"
                 role="alert">
            </div>
        }


        <div class="mb-4">

            <h5 class="mb-2">
                Categorías disponibles
            </h5>

            <p class="text-muted mb-0"
               style="font-size:14px;">

                Cuando se publique un nuevo documento en una categoría
                seleccionada, podrá recibir una notificación por correo electrónico.

            </p>

        </div>


        @if (!Model.Categorias.Any())
        {
            <div class="alert alert-warning">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                Actualmente no existen categorías disponibles para suscripción.

            </div>
        }
        else
        {
            <div class="row g-3">

                @foreach (var categoria in Model.Categorias)
                {
                    bool seleccionada =
                        Model.CategoriasSeleccionadas.Contains(
                            categoria.IdCategoria);

                    <div class="col-md-6">

                        <div class="border rounded p-3 h-100">

                            <div class="form-check">

                                <input class="form-check-input"
                                       type="checkbox"
                                       name="CategoriasSeleccionadas"
                                       value="@categoria.IdCategoria"
                                       id="categoria_@categoria.IdCategoria"
                                       checked="@seleccionada" />

                                <label class="form-check-label fw-semibold"
                                       for="categoria_@categoria.IdCategoria">

                                    @categoria.Nombre

                                </label>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(categoria.Descripcion))
                            {
                                <div class="text-muted mt-2 ms-4"
                                     style="font-size:13px;">

                                    @categoria.Descripcion

                                </div>
                            }

                        </div>

                    </div>
                }

            </div>


            <hr class="my-4" />


            <div class="alert alert-info">

                <i class="bi bi-envelope-fill me-2"></i>

                Puede modificar estas preferencias en cualquier momento.
                Si desmarca todas las categorías, dejará de recibir
                notificaciones de nuevos documentos.

            </div>


            <div class="d-flex justify-content-end gap-2">

                <a asp-controller="Transparencia"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    Cancelar

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-bell-fill me-1"></i>
                    Guardar preferencias

                </button>

            </div>
        }

    </form>

</div>