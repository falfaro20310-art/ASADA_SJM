@model AsadaSJM.Models.DocumentoTransparenciaViewModel

@{
    ViewData["Title"] = "Publicar documento";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h4 class="mb-1">
            Publicar documento
        </h4>

        <p class="text-muted mb-0">
            Registre un documento PDF para el módulo de Transparencia Institucional.
        </p>
    </div>

    <a asp-controller="Transparencia"
       asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Volver

    </a>

</div>


<div class="panel">

    <form asp-controller="Transparencia"
          asp-action="Registrar"
          method="post"
          enctype="multipart/form-data">

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All"
                 class="alert alert-danger"
                 role="alert">
            </div>
        }

        <div class="row">

            <div class="col-md-8 mb-3">

                <label asp-for="Titulo"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="Titulo"
                       class="form-control"
                       placeholder="Ejemplo: Estado financiero anual 2026" />

                <span asp-validation-for="Titulo"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-4 mb-3">

                <label asp-for="IdCategoria"
                       class="form-label fw-semibold">
                </label>

                <select asp-for="IdCategoria"
                        class="form-select">

                    <option value="">
                        Seleccione una categoría
                    </option>

                    @foreach (var categoria in Model.Categorias)
                    {
                        <option value="@categoria.IdCategoria">
                            @categoria.Nombre
                        </option>
                    }

                </select>

                <span asp-validation-for="IdCategoria"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="mb-3">

            <label asp-for="Descripcion"
                   class="form-label fw-semibold">
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="4"
                      placeholder="Ingrese una breve descripción del documento.">
            </textarea>

            <span asp-validation-for="Descripcion"
                  class="text-danger">
            </span>

        </div>


        <div class="row">

            <div class="col-md-6 mb-3">

                <label asp-for="Periodo"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="Periodo"
                       class="form-control"
                       placeholder="Ejemplo: 2026 o I semestre 2026" />

                <span asp-validation-for="Periodo"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6 mb-3">

                <label asp-for="FechaPublicacion"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="FechaPublicacion"
                       class="form-control"
                       type="date" />

                <span asp-validation-for="FechaPublicacion"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="mb-4">

            <label asp-for="ArchivoPDF"
                   class="form-label fw-semibold">
            </label>

            <input asp-for="ArchivoPDF"
                   class="form-control"
                   type="file"
                   accept=".pdf,application/pdf" />

            <span asp-validation-for="ArchivoPDF"
                  class="text-danger">
            </span>

            <div class="form-text">
                Únicamente se permiten archivos PDF de hasta 10 MB.
            </div>

        </div>


        <div class="alert alert-info">

            <i class="bi bi-info-circle-fill me-2"></i>

            El documento será publicado en el módulo de
            <strong>Transparencia Institucional</strong>
            y quedará asociado al administrador que realizó la publicación.

        </div>


        <div class="d-flex justify-content-end gap-2">

            <a asp-controller="Transparencia"
               asp-action="Index"
               class="btn btn-outline-secondary">

                Cancelar

            </a>

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-file-earmark-arrow-up me-1"></i>
                Publicar documento

            </button>

        </div>

    </form>

</div>