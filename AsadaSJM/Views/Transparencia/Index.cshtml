@model List<AsadaSJM.Models.DocumentoTransparencia>

@{
    ViewData["Title"] = "Transparencia institucional";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h4 class="mb-1">
            Transparencia institucional
        </h4>

        <p class="text-muted mb-0">
            Consulte los documentos públicos de la ASADA San José de la Montaña.
        </p>
    </div>

    @if (User.IsInRole("Administrador"))
    {
        <a asp-controller="Transparencia"
           asp-action="Registrar"
           class="btn btn-primary">

            <i class="bi bi-file-earmark-arrow-up me-1"></i>
            Publicar documento

        </a>
    }

</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["MensajeExito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>

    </div>
}


@if (!Model.Any())
{
    <div class="panel text-center py-5">

        <i class="bi bi-folder2-open"
           style="font-size:40px; color:var(--azul-agua);">
        </i>

        <h5 class="mt-3 mb-2">
            No hay documentos publicados
        </h5>

        <p class="text-muted mb-0">
            Actualmente no existen documentos disponibles
            en Transparencia Institucional.
        </p>

    </div>
}
else
{
    <div class="row g-3">

        @foreach (var documento in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="panel h-100 d-flex flex-column">

                    <div class="mb-3">

                        <i class="bi bi-file-earmark-pdf-fill"
                           style="color:var(--azul-agua); font-size:28px;">
                        </i>

                    </div>


                    <h5 class="mb-2">
                        @documento.Titulo
                    </h5>


                    <div class="text-muted mb-3"
                         style="font-size:13px;">

                        <i class="bi bi-folder me-1"></i>
                        @documento.NombreCategoria

                    </div>


                    @if (!string.IsNullOrWhiteSpace(documento.Descripcion))
                    {
                        <p class="text-muted"
                           style="font-size:14px;">

                            @documento.Descripcion

                        </p>
                    }


                    <hr class="my-3" />


                    <div style="font-size:14px;">

                        <div class="mb-2">

                            <i class="bi bi-calendar3 me-2"></i>

                            <strong>Fecha de publicación:</strong>

                            @if (documento.FechaPublicacion != default)
                            {
                                @documento.FechaPublicacion.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">
                                    No disponible
                                </span>
                            }

                        </div>


                        <div>

                            <i class="bi bi-clock-history me-2"></i>

                            <strong>Período:</strong>

                            @if (!string.IsNullOrWhiteSpace(documento.Periodo))
                            {
                                @documento.Periodo
                            }
                            else
                            {
                                <span class="text-muted">
                                    No disponible
                                </span>
                            }

                        </div>

                    </div>


                    <div class="mt-auto pt-3">

                        <a href="@documento.RutaArchivo"
                           target="_blank"
                           class="btn btn-outline-primary btn-sm">

                            <i class="bi bi-file-earmark-pdf me-1"></i>
                            Ver PDF

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}