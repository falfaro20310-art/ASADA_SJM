
@model IEnumerable<AsadaSJM.Models.Expresidente>
@using Microsoft.EntityFrameworkCore
@inject AsadaSJM.Data.ApplicationDbContext Db

@{
    Layout = "_LayoutNoAuth";
    ViewData["Title"] = "Nuestra Historia - ASADA San José de la Montaña";

    var presidenteActual =
        ViewBag.PresidenteActual as AsadaSJM.Models.Expresidente;

    var expresidentes = Model?.ToList()
        ?? new List<AsadaSJM.Models.Expresidente>();

    // Proporcionar al footer compartido la información
    // institucional que también utiliza el portal principal.
    if (ViewBag.InformacionContacto == null)
    {
        ViewBag.InformacionContacto = await Db.InformacionInstitucional
            .AsNoTracking()
            .FirstOrDefaultAsync();
    }

    int numero = 0;
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap"
      rel="stylesheet" />

<style>
    /* =============================================
       PRESIDENTES - IDENTIDAD INSTITUCIONAL
       ============================================= */

    .presidentes-page {
        --pr-blue: #004A99;
        --pr-green: #2D5A27;
        --pr-background: #F5F7F9;
        --pr-text: #20384E;
        --pr-muted: #6B7986;

        background: var(--pr-background);
        color: var(--pr-text);
        font-family: 'DM Sans', sans-serif;
        overflow: hidden;
    }

    .presidentes-page * {
        box-sizing: border-box;
    }

    .presidentes-page .editorial-title {
        font-family: 'Playfair Display', serif;
        font-weight: 500;
        letter-spacing: -1px;
    }

    .presidentes-page .section-kicker {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 3px;
        font-weight: 700;
        color: var(--pr-green);
    }

    /* =============================================
       PORTADA
       ============================================= */

    .presidentes-page .history-cover {
        position: relative;
        min-height: 610px;
        display: flex;
        align-items: center;
        background: #004A99;
        color: #FFFFFF;
        overflow: hidden;
    }

    .presidentes-page .history-cover::before {
        content: "";
        position: absolute;
        width: 720px;
        height: 720px;
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 50%;
        right: -190px;
        top: -220px;
        box-shadow:
            0 0 0 90px rgba(255,255,255,.025),
            0 0 0 180px rgba(255,255,255,.018),
            0 0 0 270px rgba(255,255,255,.012);
        pointer-events: none;
    }

    .presidentes-page .history-cover::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            circle at 75% 55%,
            rgba(45,90,39,.20),
            transparent 43%
        );
        pointer-events: none;
    }

    .presidentes-page .cover-content {
        position: relative;
        z-index: 2;
        padding-top: 80px;
        padding-bottom: 95px;
    }

    .presidentes-page .cover-number {
        position: absolute;
        right: 0;
        top: 10px;
        font-size: clamp(100px,22vw,310px);
        font-weight: 700;
        color: rgba(255,255,255,.055);
        line-height: 1;
        pointer-events: none;
        user-select: none;
    }

    .presidentes-page .cover-eyebrow {
        display: flex;
        align-items: center;
        gap: 13px;
        color: #FFFFFF;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 32px;
    }

    .presidentes-page .cover-eyebrow::before {
        content: "";
        display: block;
        width: 38px;
        height: 2px;
        background: #FFFFFF;
    }

    .presidentes-page .cover-title {
        font-size: clamp(50px,7.5vw,110px);
        line-height: 1.04;
        max-width: 950px;
        margin: 0 0 35px;
        color: #FFFFFF !important;
    }

    .presidentes-page .cover-title em {
        color: #FFFFFF;
        font-weight: 400;
    }

    .presidentes-page .cover-description {
        max-width: 530px;
        color: #E6F0FA;
        font-size: 16px;
        line-height: 1.9;
    }

    .presidentes-page .cover-actions {
        display: flex;
        gap: 22px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 36px;
    }

    .presidentes-page .cover-button {
        display: inline-flex;
        align-items: center;
        gap: 15px;
        color: #FFFFFF;
        background: #2D5A27;
        border-radius: 4px;
        padding: 15px 22px;
        text-decoration: none;
        font-weight: 700;
        transition: .25s;
    }

    .presidentes-page .cover-button:hover {
        background: #24491F;
        color: #FFFFFF;
        transform: translateY(-2px);
    }

    .presidentes-page .cover-scroll {
        font-size: 12px;
        color: #E4EEF8;
        letter-spacing: 1px;
    }

    /* =============================================
       VALORES INSTITUCIONALES
       ============================================= */

    .presidentes-page .heritage-strip {
        background: #EAF1F8;
        border-bottom: 1px solid #D3E2F0;
    }

    .presidentes-page .heritage-inner {
        min-height: 104px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .presidentes-page .heritage-item {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .presidentes-page .heritage-item i {
        font-size: 28px;
        color: #2D5A27;
    }

    .presidentes-page .heritage-item strong {
        display: block;
        color: #004A99;
        font-size: 14px;
    }

    .presidentes-page .heritage-item span {
        color: #617389;
        font-size: 12px;
    }

    /* =============================================
       LIDERAZGO ACTUAL
       ============================================= */

    .presidentes-page .current-section {
        padding: 110px 0 115px;
    }

    .presidentes-page .section-heading {
        margin-bottom: 55px;
    }

    .presidentes-page .section-heading h2 {
        font-size: clamp(39px,5vw,65px);
        line-height: 1.14;
        margin-top: 14px;
        color: #004A99;
    }

    .presidentes-page .section-heading p {
        max-width: 550px;
        font-size: 15px;
        line-height: 1.9;
        color: var(--pr-muted);
    }

    .presidentes-page .current-feature {
        display: grid;
        grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr);
        align-items: center;
        gap: clamp(30px,6vw,100px);
    }

    .presidentes-page .current-portrait-wrapper {
        position: relative;
        padding: 0 35px 38px 0;
    }

    .presidentes-page .current-portrait-wrapper::after {
        content: "";
        position: absolute;
        top: 35px;
        left: 35px;
        right: 0;
        bottom: 0;
        border: 2px solid #2D5A27;
        z-index: 0;
    }

    .presidentes-page .current-portrait {
        position: relative;
        z-index: 1;
        height: 490px;
        background: linear-gradient(145deg,#C9DFF1,#598AB7);
        overflow: hidden;
    }

    .presidentes-page .current-portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
        display: block;
        filter: saturate(.90);
    }

    .presidentes-page .current-portrait-placeholder {
        height: 100%;
        display: grid;
        place-items: center;
        color: rgba(255,255,255,.85);
        font-size: 110px;
    }

    .presidentes-page .portrait-corner {
        position: absolute;
        bottom: 64px;
        right: 5px;
        z-index: 3;
        background: #004A99;
        color: white;
        padding: 16px 22px;
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .presidentes-page .current-copy {
        min-width: 0;
    }

    .presidentes-page .current-copy h3 {
        font-size: clamp(39px,5vw,68px);
        margin: 17px 0 22px;
        line-height: 1.1;
        color: #004A99;
        overflow-wrap: anywhere;
    }

    .presidentes-page .current-role {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #2D5A27;
        background: #E8F2E6;
        padding: 9px 15px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .presidentes-page .green-line {
        width: 65px;
        height: 2px;
        background: #2D5A27;
        margin: 35px 0;
    }

    .presidentes-page .story-block {
        margin-bottom: 28px;
    }

    .presidentes-page .story-block h4 {
        font-weight: 700;
        color: #2D5A27;
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .presidentes-page .story-block p {
        line-height: 1.9;
        font-size: 15px;
        color: #5F7180;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    /* =============================================
       FRASE INSTITUCIONAL
       ============================================= */

    .presidentes-page .history-quote {
        background: #E8F2E6;
        padding: 65px 20px;
        text-align: center;
    }

    .presidentes-page .history-quote i {
        display: block;
        font-size: 33px;
        color: #2D5A27;
        margin-bottom: 15px;
    }

    .presidentes-page .history-quote p {
        font-family: 'Playfair Display', serif;
        font-size: clamp(24px,3.5vw,39px);
        line-height: 1.45;
        max-width: 850px;
        margin: auto;
        color: #004A99;
    }

    /* =============================================
       EXPRESIDENTES
       ============================================= */

    .presidentes-page .legacy-section {
        padding: 110px 0 130px;
    }

    .presidentes-page .legacy-intro {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 55px;
    }

    .presidentes-page .legacy-intro h2 {
        font-size: clamp(40px,5vw,67px);
        margin: 15px 0 0;
        color: #004A99;
    }

    .presidentes-page .legacy-count {
        color: var(--pr-muted);
        font-size: 13px;
        letter-spacing: 1px;
    }

    .presidentes-page .legacy-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 30px;
        align-items: start;
    }

    .presidentes-page .legacy-card {
        min-width: 0;
        background: #FFFFFF;
        border: 1px solid #E1E9F1;
        transition: transform .3s, box-shadow .3s;
    }

    .presidentes-page .legacy-card:nth-child(3n + 2) {
        margin-top: 55px;
    }

    .presidentes-page .legacy-card:hover {
        transform: translateY(-7px);
        box-shadow: 0 24px 50px rgba(0,74,153,.13);
    }

    .presidentes-page .legacy-photo {
        height: 320px;
        position: relative;
        background: #CEE1F0;
        overflow: hidden;
    }

    .presidentes-page .legacy-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .55s;
    }

    .presidentes-page .legacy-card:hover .legacy-photo img {
        transform: scale(1.06);
    }

    .presidentes-page .legacy-placeholder {
        height: 100%;
        display: grid;
        place-items: center;
        background: linear-gradient(140deg,#CADDEC,#457CA9);
        color: white;
        font-size: 75px;
    }

    .presidentes-page .legacy-number {
        position: absolute;
        top: 16px;
        left: 16px;
        padding: 8px 12px;
        color: white;
        background: rgba(0,74,153,.86);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .presidentes-page .legacy-content {
        padding: 27px;
    }

    .presidentes-page .legacy-category {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #2D5A27;
        font-weight: 700;
    }

    .presidentes-page .legacy-content h3 {
        font-family: 'Playfair Display', serif;
        font-size: 28px;
        margin: 10px 0 20px;
        color: #004A99;
        overflow-wrap: anywhere;
    }

    /* =============================================
       DETALLES INTERACTIVOS
       ============================================= */

    .presidentes-page .legacy-details {
        border-top: 1px solid #E3EAF2;
        padding-top: 15px;
    }

    .presidentes-page .legacy-details summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        list-style: none;
        font-size: 13px;
        font-weight: 700;
        color: #2D5A27;
        user-select: none;
    }

    .presidentes-page .legacy-details summary::-webkit-details-marker {
        display: none;
    }

    .presidentes-page .legacy-details summary i {
        font-size: 17px;
        transition: transform .2s;
    }

    .presidentes-page .legacy-details[open] summary i {
        transform: rotate(45deg);
    }

    .presidentes-page .legacy-details-body {
        padding-top: 23px;
        animation: legacyReveal .25s ease;
    }

    .presidentes-page .legacy-details-body h4 {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #2D5A27;
        margin: 0 0 8px;
    }

    .presidentes-page .legacy-details-body p {
        font-size: 13px;
        line-height: 1.8;
        color: #627285;
        white-space: pre-line;
        overflow-wrap: anywhere;
        margin-bottom: 20px;
    }

    @@keyframes legacyReveal {
        from {
            opacity: 0;
            transform: translateY(-7px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .presidentes-page .history-empty {
        padding: 65px 25px;
        text-align: center;
        background: #FFFFFF;
        border: 1px dashed #BDCDDF;
        color: #6B7986;
    }

    .presidentes-page .history-empty i {
        display: block;
        font-size: 44px;
        margin-bottom: 16px;
        color: #2D5A27;
    }

    /* =============================================
       CIERRE EDITORIAL
       ============================================= */

    .presidentes-page .history-end {
        background: #004A99;
        padding: 80px 20px 90px;
        text-align: center;
        color: #FFFFFF;
    }

    .presidentes-page .history-end .section-kicker {
        color: #FFFFFF;
    }

    .presidentes-page .history-end .editorial-title {
        font-size: clamp(30px,4vw,50px);
        max-width: 750px;
        margin: 20px auto;
        color: #FFFFFF !important;
    }

    .presidentes-page .history-end p {
        color: #FFFFFF;
        margin-bottom: 0;
    }

    /* =============================================
       CORRECCIÓN DE SEPARACIÓN CON EL FOOTER

       Se conserva el diseño editorial azul.
       La separación utiliza el fondo gris claro
       institucional sin agregar bordes artificiales.
       ============================================= */

    .presidentes-page {
        border-bottom: 0 !important;
    }

    .presidentes-page .history-end {
        background: #F5F7F9 !important;
        color: #004A99 !important;
        border-top: 1px solid #E0E8F0;
        border-bottom: 1px solid #E0E8F0;
    }

    .presidentes-page .history-end .section-kicker {
        color: #2D5A27 !important;
    }

    .presidentes-page .history-end .editorial-title {
        color: #004A99 !important;
    }

    .presidentes-page .history-end p {
        color: #53677B !important;
    }

    /* =============================================
       RESPONSIVE
       ============================================= */

    @@media(max-width: 991px) {
        .presidentes-page .legacy-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .presidentes-page .legacy-card:nth-child(3n + 2) {
            margin-top: 0;
        }

        .presidentes-page .legacy-card:nth-child(even) {
            margin-top: 35px;
        }

        .presidentes-page .current-feature {
            gap: 35px;
        }

        .presidentes-page .current-portrait {
            height: 400px;
        }
    }

    @@media(max-width: 767px) {
        .presidentes-page .history-cover {
            min-height: 550px;
        }

        .presidentes-page .cover-content {
            padding-top: 65px;
            padding-bottom: 65px;
        }

        .presidentes-page .heritage-inner {
            flex-wrap: wrap;
            padding: 25px 0;
        }

        .presidentes-page .heritage-item {
            width: 100%;
        }

        .presidentes-page .current-section,
        .presidentes-page .legacy-section {
            padding: 70px 0;
        }

        .presidentes-page .current-feature {
            grid-template-columns: 1fr;
        }

        .presidentes-page .current-portrait {
            height: 430px;
        }

        .presidentes-page .legacy-grid {
            grid-template-columns: 1fr;
        }

        .presidentes-page .legacy-card:nth-child(even) {
            margin-top: 0;
        }

        .presidentes-page .legacy-intro {
            flex-direction: column;
            align-items: start;
        }
    }

    @@media(prefers-reduced-motion: reduce) {
        .presidentes-page *,
        .presidentes-page *::before,
        .presidentes-page *::after {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<main class="presidentes-page">

    <!-- PORTADA -->

    <section class="history-cover">
        <div class="container cover-content">

            <span class="cover-number" aria-hidden="true">
                AS
            </span>

            <div class="cover-eyebrow">
                ASADA SAN JOSÉ DE LA MONTAÑA
            </div>

            <h1 class="editorial-title cover-title">
                Nuestra historia.<br />
                <em>Su legado.</em>
            </h1>

            <p class="cover-description">
                Detrás de cada avance hay personas que han
                dedicado tiempo, compromiso y visión al
                bienestar de nuestra comunidad y al cuidado
                del recurso hídrico.
            </p>

            <div class="cover-actions">

                <a href="#liderazgo-actual"
                   class="cover-button">
                    Conocer nuestra historia
                    <i class="bi bi-arrow-down-right"></i>
                </a>

                <span class="cover-scroll">
                    DESLIZA PARA EXPLORAR
                    <i class="bi bi-arrow-down ms-2"></i>
                </span>

            </div>

        </div>
    </section>

    <!-- PRINCIPIOS INSTITUCIONALES -->

    <section class="heritage-strip">
        <div class="container heritage-inner">

            <div class="heritage-item">
                <i class="bi bi-droplet-half"></i>
                <div>
                    <strong>Compromiso con el agua</strong>
                    <span>Nuestro recurso más valioso</span>
                </div>
            </div>

            <div class="heritage-item">
                <i class="bi bi-people"></i>
                <div>
                    <strong>Liderazgo comunitario</strong>
                    <span>Personas al servicio de la comunidad</span>
                </div>
            </div>

            <div class="heritage-item">
                <i class="bi bi-tree"></i>
                <div>
                    <strong>Visión sostenible</strong>
                    <span>Protección para futuras generaciones</span>
                </div>
            </div>

        </div>
    </section>

    <!-- PRESIDENTE ACTUAL -->

    <section class="current-section" id="liderazgo-actual">
        <div class="container">

            <div class="section-heading">

                <span class="section-kicker">
                    01 / PRESENTE
                </span>

                <h2 class="editorial-title">
                    El liderazgo de hoy.
                </h2>

                <p>
                    Conoce a la persona que actualmente
                    representa la presidencia de nuestra ASADA.
                </p>

            </div>

            @if (presidenteActual != null)
            {
                <article class="current-feature">

                    <div class="current-portrait-wrapper">

                        <div class="current-portrait">

                            @if (!string.IsNullOrWhiteSpace(presidenteActual.Imagen))
                            {
                                <img src="@presidenteActual.Imagen"
                                     alt="Fotografía de @presidenteActual.Nombre"
                                     loading="lazy"
                                     onerror="this.style.display='none';this.nextElementSibling.hidden=false;" />

                                <div class="current-portrait-placeholder" hidden>
                                    <i class="bi bi-person-circle"></i>
                                </div>
                            }
                            else
                            {
                                <div class="current-portrait-placeholder">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                            }

                        </div>

                        <div class="portrait-corner">
                            PRESIDENCIA ACTUAL
                        </div>

                    </div>

                    <div class="current-copy">

                        <span class="current-role">
                            <i class="bi bi-patch-check-fill"></i>
                            REPRESENTACIÓN ACTUAL
                        </span>

                        <h3 class="editorial-title">
                            @presidenteActual.Nombre
                        </h3>

                        <div class="green-line"></div>

                        <div class="story-block">

                            <h4>Su trayectoria</h4>

                            <p>
                                @(string.IsNullOrWhiteSpace(presidenteActual.Trayectoria)
                                    ? "Información de trayectoria pendiente de publicación."
                                    : presidenteActual.Trayectoria)
                            </p>

                        </div>

                        <div class="story-block">

                            <h4>Proyectos e iniciativas</h4>

                            <p>
                                @(string.IsNullOrWhiteSpace(presidenteActual.Proyectos)
                                    ? "Información de proyectos pendiente de publicación."
                                    : presidenteActual.Proyectos)
                            </p>

                        </div>

                    </div>

                </article>
            }
            else
            {
                <div class="history-empty">
                    <i class="bi bi-person-badge"></i>
                    No hay información publicada sobre la presidencia actual.
                </div>
            }

        </div>
    </section>

    <!-- MENSAJE INSTITUCIONAL -->

    <section class="history-quote">

        <i class="bi bi-water"></i>

        <p>
            “El agua nos conecta.
            Las personas construyen nuestro futuro.”
        </p>

    </section>

    <!-- EXPRESIDENTES -->

    <section class="legacy-section" id="nuestro-legado">
        <div class="container">

            <div class="legacy-intro">

                <div>
                    <span class="section-kicker">
                        02 / LEGADO
                    </span>

                    <h2 class="editorial-title">
                        Huellas que permanecen.
                    </h2>
                </div>

                <span class="legacy-count">
                    @expresidentes.Count
                    @(expresidentes.Count == 1
                        ? "REGISTRO HISTÓRICO"
                        : "REGISTROS HISTÓRICOS")
                </span>

            </div>

            @if (expresidentes.Any())
            {
                <div class="legacy-grid">

                    @foreach (var expresidente in expresidentes)
                    {
                        numero++;

                        <article class="legacy-card">

                            <div class="legacy-photo">

                                @if (!string.IsNullOrWhiteSpace(expresidente.Imagen))
                                {
                                    <img src="@expresidente.Imagen"
                                         alt="Fotografía de @expresidente.Nombre"
                                         loading="lazy"
                                         onerror="this.style.display='none';this.nextElementSibling.hidden=false;" />

                                    <div class="legacy-placeholder" hidden>
                                        <i class="bi bi-person-circle"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="legacy-placeholder">
                                        <i class="bi bi-person-circle"></i>
                                    </div>
                                }

                                <span class="legacy-number">
                                    @numero.ToString("D2")
                                </span>

                            </div>

                            <div class="legacy-content">

                                <span class="legacy-category">
                                    EXPRESIDENCIA
                                </span>

                                <h3>@expresidente.Nombre</h3>

                                <details class="legacy-details">

                                    <summary>
                                        Descubrir su historia
                                        <i class="bi bi-plus-lg"></i>
                                    </summary>

                                    <div class="legacy-details-body">

                                        <h4>Trayectoria</h4>

                                        <p>
                                            @(string.IsNullOrWhiteSpace(expresidente.Trayectoria)
                                                ? "No hay información disponible."
                                                : expresidente.Trayectoria)
                                        </p>

                                        <h4>Proyectos realizados</h4>

                                        <p>
                                            @(string.IsNullOrWhiteSpace(expresidente.Proyectos)
                                                ? "No hay información disponible."
                                                : expresidente.Proyectos)
                                        </p>

                                    </div>

                                </details>

                            </div>

                        </article>
                    }

                </div>
            }
            else
            {
                <div class="history-empty">
                    <i class="bi bi-journal-bookmark"></i>
                    Todavía no hay expresidentes publicados.
                </div>
            }

        </div>
    </section>

    <!-- CIERRE EDITORIAL -->

    <section class="history-end">

        <div class="container">

            <span class="section-kicker">
                UN LEGADO COMPARTIDO
            </span>

            <h2 class="editorial-title">
                Nuestra historia continúa
                con cada generación.
            </h2>

            <p>
                ASADA San José de la Montaña
            </p>

        </div>

    </section>

</main>
