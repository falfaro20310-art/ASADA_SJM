@model AsadaSJM.Models.Expresidente

@{
    ViewData["Title"] = "Editar presidente";
}

<div class="panel" style="max-width:520px;">

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="IdExpresidente" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="mb-3">

            <label class="form-label"
                   asp-for="Nombre">
                Nombre
            </label>

            <input asp-for="Nombre"
                   class="form-control"
                   required />

            <span asp-validation-for="Nombre"
                  class="text-danger">
            </span>

        </div>


        <div class="mb-3">

            <label class="form-label"
                   asp-for="Trayectoria">
                Trayectoria
            </label>

            <textarea asp-for="Trayectoria"
                      class="form-control"
                      rows="4"></textarea>

            <span asp-validation-for="Trayectoria"
                  class="text-danger">
            </span>

        </div>


        <div class="mb-3">

            <label class="form-label"
                   asp-for="Proyectos">
                Proyectos
            </label>

            <textarea asp-for="Proyectos"
                      class="form-control"
                      rows="4"></textarea>

            <span asp-validation-for="Proyectos"
                  class="text-danger">
            </span>

        </div>


        <div class="mb-3">

            <label class="form-label"
                   asp-for="Imagen">
                Imagen
            </label>

            <input asp-for="Imagen"
                   class="form-control"
                   placeholder="Ruta o URL de la imagen" />

            <span asp-validation-for="Imagen"
                  class="text-danger">
            </span>

        </div>


        <div class="mb-3">

            <div class="form-check">

                <input asp-for="Estado"
                       class="form-check-input" />

                <label class="form-check-label"
                       asp-for="Estado">
                    Presidente actual
                </label>

            </div>

        </div>


        <button type="submit"
                class="btn btn-agua">
            Guardar cambios
        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Cancelar
        </a>

    </form>

</div>