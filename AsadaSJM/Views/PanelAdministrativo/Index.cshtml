@using System.Data

@{
    ViewData["Title"] = "Gestión del Panel Administrativo";

    var tab = ViewBag.Tab as string ?? "noticias";

    var noticias = (DataTable)ViewBag.Noticias;
    var documentos = (DataTable)ViewBag.Documentos;
    var versiones = (DataTable)ViewBag.Versiones;
    var tramites = (DataTable)ViewBag.Tramites;
    var fontaneros = (DataTable)ViewBag.Fontaneros;
    var averias = (DataTable)ViewBag.Averias;
    var ordenes = (DataTable)ViewBag.Ordenes;
    var abonados = (DataTable)ViewBag.Abonados;
    var tarifas = (DataTable)ViewBag.Tarifas;
    var seleccionado = (DataTable)ViewBag.AbonadoSeleccionado;
    var cambios = (DataTable)ViewBag.Cambios;
    var contratos = (DataTable)ViewBag.Contratos;

    var persona = seleccionado.Rows.Count > 0
        ? seleccionado.Rows[0] : null;

    string Texto(DataRow fila, string columna) =>
        fila.Table.Columns.Contains(columna) &&
        fila[columna] != DBNull.Value
            ? fila[columna].ToString() ?? ""
            : "";

    string Fecha(DataRow fila, string columna) =>
        fila.Table.Columns.Contains(columna) &&
        fila[columna] is DateTime fecha
            ? fecha.ToString("dd/MM/yyyy")
            : "—";

    string FechaInput(DataRow fila, string columna) =>
        fila.Table.Columns.Contains(columna) &&
        fila[columna] is DateTime fecha
            ? fecha.ToString("yyyy-MM-dd")
            : "";
}

<style>
    .mpa-title {
        color: #004a99;
        font-size: 19px;
        font-weight: 700;
    }

    .mpa-subtitle {
        color: #2d5a27;
        font-size: 17px;
        font-weight: 700;
    }

    .mpa-actions {
        white-space: nowrap;
    }

    .mpa-actions .btn {
        margin-right: 5px;
        margin-bottom: 3px;
    }

    .mpa-modal-title {
        color: #004a99;
        font-weight: 700;
    }

    .mpa-muted {
        color: #64748b;
        font-size: 13px;
    }

    .mpa-long {
        max-width: 430px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mpa-tabs .btn {
        margin: 0 5px 6px 0;
    }

    /* Contadores clicables (MPA-04 y MPA-05) */

    .mpa-kpi {
        display: block;
        background: #ffffff;
        border: 1px solid #dde7ef;
        border-left: 5px solid #94a3b8;
        border-radius: 12px;
        padding: 14px 16px;
        text-decoration: none;
        color: #20384e;
        transition: box-shadow .15s ease;
    }

    .mpa-kpi:hover {
        box-shadow: 0 4px 14px rgba(0, 74, 153, .12);
        color: #20384e;
    }

    .mpa-kpi-num {
        display: block;
        font-size: 26px;
        font-weight: 700;
        line-height: 1.1;
    }

    .mpa-kpi-label {
        font-size: 13px;
        color: #64748b;
    }

    .mpa-kpi-warning { border-left-color: #f2b705; }
    .mpa-kpi-info { border-left-color: #0dcaf0; }
    .mpa-kpi-success { border-left-color: #2d5a27; }
    .mpa-kpi-danger { border-left-color: #dc3545; }
</style>

<!-- MENÚ DEL PANEL -->

<div class="panel mb-3">

    <h2 class="mpa-title mb-2">
        Panel administrativo
    </h2>

    <nav class="mpa-tabs d-flex flex-wrap"
         aria-label="Secciones administrativas">

        <a asp-action="Index"
           asp-route-tab="noticias"
           class="btn @(tab == "noticias" ? "btn-agua" : "btn-outline-primary")">
            Noticias · MPA-02
        </a>

        <a asp-action="Index"
           asp-route-tab="documentos"
           class="btn @(tab == "documentos" ? "btn-agua" : "btn-outline-primary")">
            Documentos · MPA-03
        </a>

        <a asp-action="Index"
           asp-route-tab="tramites"
           class="btn @(tab == "tramites" ? "btn-agua" : "btn-outline-primary")">
            Trámites · MPA-04
        </a>

        <a asp-action="Index"
           asp-route-tab="averias"
           class="btn @(tab == "averias" ? "btn-agua" : "btn-outline-primary")">
            Averías · MPA-05
        </a>

        <a asp-action="Index"
           asp-route-tab="abonados"
           class="btn @(tab == "abonados" ? "btn-agua" : "btn-outline-primary")">
            Abonados · MPA-06
        </a>

    </nav>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success" role="status">
        @TempData["Ok"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
}

<!-- ====================================== -->
<!-- MPA-02: NOTICIAS -->
<!-- ====================================== -->

@if (tab == "noticias")
{
    <div class="panel">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

            <div>
                <h3 class="mpa-subtitle mb-1">
                    Noticias institucionales
                </h3>

                <p class="mpa-muted mb-0">
                    Publica, guarda borradores y modifica noticias desde el listado.
                </p>
            </div>

            <button type="button"
                    class="btn btn-agua js-noticia-nueva"
                    data-bs-toggle="modal"
                    data-bs-target="#modalNoticia">

                <i class="bi bi-plus-lg"></i>
                Nueva noticia
            </button>

        </div>

        <div class="table-responsive">

            <table class="table table-asada align-middle mb-0">

                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Estado</th>
                        <th>Vigencia</th>
                        <th>Imagen</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (DataRow n in noticias.Rows)
                    {
                        bool vencida = Texto(n, "Vencida") == "1";

                        <tr>
                            <td>
                                <strong>@Texto(n, "Titulo")</strong>

                                <div class="mpa-muted mpa-long">
                                    @Texto(n, "Contenido")
                                </div>
                            </td>

                            <td>
                                @if (vencida)
                                {
                                    <span class="badge bg-secondary">
                                        Vencida
                                    </span>
                                }
                                else if (Texto(n, "Estado") == "Publicado")
                                {
                                    <span class="badge bg-success">
                                        Publicada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Borrador
                                    </span>
                                }
                            </td>

                            <td>@Fecha(n, "FechaVigencia")</td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(Texto(n, "RutaImagen")))
                                {
                                    <img src="@Texto(n, "RutaImagen")"
                                         alt="Imagen de noticia"
                                         style="width:78px;height:52px;object-fit:cover;border-radius:5px;" />
                                }
                                else
                                {
                                    <span class="mpa-muted">Sin imagen</span>
                                }
                            </td>

                            <td class="mpa-actions">

                                <button type="button"
                                        class="btn btn-sm btn-outline-primary js-noticia-editar"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalNoticia"
                                        data-id="@Texto(n, "IdNoticia")"
                                        data-titulo="@Texto(n, "Titulo")"
                                        data-contenido="@Texto(n, "Contenido")"
                                        data-vigencia="@FechaInput(n, "FechaVigencia")">

                                    <i class="bi bi-pencil-square"></i>
                                    Editar
                                </button>

                                <form asp-action="CambiarEstadoNoticia"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="idNoticia"
                                           value="@Texto(n, "IdNoticia")" />

                                    <input type="hidden"
                                           name="estado"
                                           value="@(Texto(n, "Estado") == "Publicado" ? "Borrador" : "Publicado")" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary">

                                        @(Texto(n, "Estado") == "Publicado" ? "Retirar" : "Publicar")
                                    </button>

                                </form>

                            </td>
                        </tr>
                    }

                    @if (noticias.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                Aún no hay noticias registradas.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

    <!-- MODAL EDITAR NOTICIA -->

    <div class="modal fade"
         id="modalNoticia"
         tabindex="-1"
         aria-labelledby="tituloModalNoticia"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <form asp-action="GuardarNoticia"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5 class="modal-title mpa-modal-title"
                            id="tituloModalNoticia">
                            Nueva noticia
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>

                    </div>

                    <div class="modal-body row g-3">

                        <input type="hidden"
                               id="n-id"
                               name="idNoticia"
                               value="0" />

                        <div class="col-md-8">
                            <label for="n-titulo" class="form-label">
                                Título
                            </label>

                            <input id="n-titulo"
                                   name="titulo"
                                   class="form-control"
                                   maxlength="200"
                                   required />
                        </div>

                        <div class="col-md-4">
                            <label for="n-fecha" class="form-label">
                                Vigente hasta
                            </label>

                            <input id="n-fecha"
                                   name="fechaVigencia"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <div class="col-12">
                            <label for="n-contenido" class="form-label">
                                Contenido
                            </label>

                            <textarea id="n-contenido"
                                      name="contenido"
                                      rows="5"
                                      class="form-control"
                                      required></textarea>
                        </div>

                        <div class="col-12">
                            <label for="n-imagen" class="form-label">
                                Imagen (JPG, PNG o WEBP)
                            </label>

                            <input id="n-imagen"
                                   name="imagen"
                                   type="file"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   class="form-control" />

                            <div class="form-text">
                                Si estás editando, deja este campo vacío para conservar la imagen anterior.
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit"
                                name="accion"
                                value="Borrador"
                                class="btn btn-outline-primary">
                            Guardar borrador
                        </button>

                        <button type="submit"
                                name="accion"
                                value="Publicar"
                                class="btn btn-agua">
                            Publicar
                        </button>

                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- ====================================== -->
<!-- MPA-03: DOCUMENTOS -->
<!-- ====================================== -->

@if (tab == "documentos")
{
    <div class="panel mb-3">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

            <div>
                <h3 class="mpa-subtitle mb-1">
                    Documentos y control de versiones
                </h3>

                <p class="mpa-muted mb-0">
                    Edita documentos o registra nuevas versiones.
                </p>
            </div>

            <button type="button"
                    class="btn btn-agua js-version-nueva"
                    data-bs-toggle="modal"
                    data-bs-target="#modalVersion">

                <i class="bi bi-plus-lg"></i>
                Nuevo documento
            </button>

        </div>

        <div class="table-responsive">

            <table class="table table-asada align-middle mb-0">

                <thead>
                    <tr>
                        <th>Documento</th>
                        <th>Tipo</th>
                        <th>Versiones</th>
                        <th>Actualización</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (DataRow d in documentos.Rows)
                    {
                        <tr>
                            <td>
                                <strong>@Texto(d, "Titulo")</strong>

                                <div class="mpa-muted">
                                    @Texto(d, "Descripcion")
                                </div>
                            </td>

                            <td>@Texto(d, "TipoDocumento")</td>
                            <td>@Texto(d, "Versiones")</td>
                            <td>@Fecha(d, "UltimaActualizacion")</td>

                            <td class="mpa-actions">

                                <button type="button"
                                        class="btn btn-sm btn-outline-primary js-doc-editar"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalDocumento"
                                        data-id="@Texto(d, "IdDocumentoControl")"
                                        data-titulo="@Texto(d, "Titulo")"
                                        data-tipo="@Texto(d, "TipoDocumento")"
                                        data-descripcion="@Texto(d, "Descripcion")">

                                    Editar ficha
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-agua js-version-existente"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalVersion"
                                        data-id="@Texto(d, "IdDocumentoControl")"
                                        data-titulo="@Texto(d, "Titulo")"
                                        data-tipo="@Texto(d, "TipoDocumento")">

                                    Nueva versión
                                </button>

                            </td>
                        </tr>
                    }

                    @if (documentos.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                No hay documentos registrados.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

    <!-- HISTORIAL -->

    <div class="panel">

        <h3 class="mpa-subtitle mb-3">
            Historial de versiones
        </h3>

        <div class="table-responsive">

            <table class="table table-asada align-middle mb-0">

                <thead>
                    <tr>
                        <th>Documento</th>
                        <th>Versión</th>
                        <th>Archivo</th>
                        <th>Responsable</th>
                        <th>Cargo</th>
                        <th>Fecha</th>
                        <th>Descarga</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (DataRow v in versiones.Rows)
                    {
                        <tr>
                            <td>@Texto(v, "Titulo")</td>
                            <td>@Texto(v, "NumeroVersion")</td>
                            <td>@Texto(v, "NombreArchivo")</td>
                            <td>@Texto(v, "Responsable")</td>
                            <td>@Texto(v, "Cargo")</td>
                            <td>@Fecha(v, "FechaActualizacion")</td>

                            <td>
                                <a asp-action="DescargarVersion"
                                   asp-route-id="@Texto(v, "IdVersion")"
                                   class="btn btn-sm btn-outline-primary">

                                    Descargar PDF
                                </a>
                            </td>
                        </tr>
                    }

                    @if (versiones.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                Todavía no hay versiones registradas.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>
    </div>

    <!-- MODAL EDITAR DOCUMENTO -->

    <div class="modal fade"
         id="modalDocumento"
         tabindex="-1"
         aria-labelledby="tituloModalDocumento"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form asp-action="ActualizarDocumento"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5 class="modal-title mpa-modal-title"
                            id="tituloModalDocumento">
                            Editar documento
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>
                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               id="d-id"
                               name="idDocumentoControl" />

                        <label for="d-titulo" class="form-label">
                            Título
                        </label>

                        <input id="d-titulo"
                               name="titulo"
                               maxlength="250"
                               required
                               class="form-control mb-3" />

                        <label for="d-tipo" class="form-label">
                            Tipo de documento
                        </label>

                        <select id="d-tipo"
                                name="tipoDocumento"
                                class="form-select mb-3">

                            <option>Ficha institucional</option>
                            <option>Resolución exoneración</option>

                        </select>

                        <label for="d-descripcion" class="form-label">
                            Descripción
                        </label>

                        <textarea id="d-descripcion"
                                  name="descripcion"
                                  maxlength="1000"
                                  rows="3"
                                  class="form-control"></textarea>

                        <p class="mpa-muted mt-2 mb-0">
                            Las versiones anteriores se conservarán.
                        </p>
                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button class="btn btn-agua">
                            Guardar cambios
                        </button>

                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- MODAL NUEVA VERSIÓN -->

    <div class="modal fade"
         id="modalVersion"
         tabindex="-1"
         aria-labelledby="tituloModalVersion"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <form asp-action="NuevaVersion"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5 class="modal-title mpa-modal-title"
                            id="tituloModalVersion">
                            Nuevo documento
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>
                    </div>

                    <div class="modal-body row g-3">

                        <input id="v-id"
                               name="idDocumentoControl"
                               type="hidden"
                               value="0" />

                        <div class="col-md-8">
                            <label for="v-titulo" class="form-label">
                                Documento
                            </label>

                            <input id="v-titulo"
                                   name="titulo"
                                   maxlength="250"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-4">
                            <label for="v-tipo" class="form-label">
                                Tipo
                            </label>

                            <select id="v-tipo"
                                    name="tipoDocumento"
                                    class="form-select">

                                <option>Ficha institucional</option>
                                <option>Resolución exoneración</option>

                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="v-responsable" class="form-label">
                                Responsable
                            </label>

                            <input id="v-responsable"
                                   name="responsable"
                                   maxlength="200"
                                   required
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label for="v-cargo" class="form-label">
                                Cargo
                            </label>

                            <input id="v-cargo"
                                   name="cargo"
                                   maxlength="150"
                                   required
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label for="v-archivo" class="form-label">
                                Nueva versión PDF
                            </label>

                            <input id="v-archivo"
                                   type="file"
                                   name="archivo"
                                   accept=".pdf"
                                   required
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label for="v-firma" class="form-label">
                                Declaración firmada
                            </label>

                            <input id="v-firma"
                                   type="file"
                                   name="declaracionFirmada"
                                   accept=".pdf"
                                   class="form-control" />
                        </div>

                        <div class="col-12">
                            <div class="alert alert-light border mb-0">
                                Para fichas institucionales es obligatorio adjuntar la declaración firmada.
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button class="btn btn-agua">
                            Guardar versión
                        </button>

                    </div>

                </form>
            </div>
        </div>
    </div>
}

<!-- ====================================== -->
<!-- MPA-04: TRÁMITES -->
<!-- ====================================== -->

@if (tab == "tramites")
{
    var conteos = (DataTable)ViewBag.Conteos;

    string vista = ViewBag.Vista as string ?? "todos";
    string? buscarFiltro = ViewBag.Buscar as string;
    string? estadoFiltroActual = ViewBag.Estado as string;
    bool verTodos = (ViewBag.Todos as bool?) ?? false;

    int paginaTramites = (int)(ViewBag.Pagina ?? 1);
    int paginasTramites = (int)(ViewBag.TotalPaginas ?? 1);
    int filasTramites = (int)(ViewBag.TotalFilas ?? 0);

    Func<int, string[], int> contar = (esAveria, estados) =>
        conteos.Rows.Cast<DataRow>()
            .Where(r => Texto(r, "EsAveria") == esAveria.ToString()
                     && estados.Contains(Texto(r, "Estado")))
            .Sum(r => Convert.ToInt32(r["Cantidad"]));

    string[] estadosAbiertos = { "Pendiente", "En proceso", "En revisión", "Recibido" };
    string[] estadosCerrados = { "Aprobado", "Rechazado", "Resuelta", "Cerrada" };

    int tramitesPendientes = contar(0, new[] { "Pendiente" });
    int averiasPendientes = contar(1, new[] { "Pendiente" });
    int averiasEnProceso = contar(1, new[] { "En proceso" });
    int cerrados = contar(0, estadosCerrados) + contar(1, estadosCerrados);

    int abiertosTramites = contar(0, estadosAbiertos);
    int abiertosAverias = contar(1, estadosAbiertos);

    var filtrosTramites = new Dictionary<string, string> { ["tab"] = "tramites" };

    if (vista != "todos") { filtrosTramites["vista"] = vista; }
    if (!string.IsNullOrWhiteSpace(buscarFiltro)) { filtrosTramites["buscar"] = buscarFiltro; }
    if (!string.IsNullOrWhiteSpace(estadoFiltroActual)) { filtrosTramites["estado"] = estadoFiltroActual; }
    if (verTodos) { filtrosTramites["todos"] = "true"; }

    Func<int, Dictionary<string, string>> rutaPaginaTramites = numeroPagina =>
        new Dictionary<string, string>(filtrosTramites)
        {
            ["pagina"] = numeroPagina.ToString()
        };

    int desdeTramites = filasTramites == 0 ? 0 : ((paginaTramites - 1) * 20) + 1;
    int hastaTramites = Math.Min(paginaTramites * 20, filasTramites);

    <!-- CONTADORES (CLIC PARA FILTRAR) -->

    <div class="row g-3 mb-3">

        <div class="col-6 col-lg-3">
            <a class="mpa-kpi mpa-kpi-warning"
               asp-action="Index"
               asp-route-tab="tramites"
               asp-route-vista="tramites"
               asp-route-estado="Pendiente">

                <span class="mpa-kpi-num">@tramitesPendientes</span>
                <span class="mpa-kpi-label">Trámites pendientes</span>
            </a>
        </div>

        <div class="col-6 col-lg-3">
            <a class="mpa-kpi mpa-kpi-warning"
               asp-action="Index"
               asp-route-tab="tramites"
               asp-route-vista="averias"
               asp-route-estado="Pendiente">

                <span class="mpa-kpi-num">@averiasPendientes</span>
                <span class="mpa-kpi-label">Averías pendientes</span>
            </a>
        </div>

        <div class="col-6 col-lg-3">
            <a class="mpa-kpi mpa-kpi-info"
               asp-action="Index"
               asp-route-tab="tramites"
               asp-route-vista="averias"
               asp-route-estado="En proceso">

                <span class="mpa-kpi-num">@averiasEnProceso</span>
                <span class="mpa-kpi-label">Averías en proceso</span>
            </a>
        </div>

        <div class="col-6 col-lg-3">
            <a class="mpa-kpi mpa-kpi-success"
               asp-action="Index"
               asp-route-tab="tramites"
               asp-route-todos="true">

                <span class="mpa-kpi-num">@cerrados</span>
                <span class="mpa-kpi-label">Cerrados (histórico)</span>
            </a>
        </div>

    </div>

    <div class="panel mb-3">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">

            <h3 class="mpa-subtitle mb-0">
                Bandeja de trámites
            </h3>

            <!-- VISTA: TODOS / TRÁMITES / AVERÍAS -->

            <div class="btn-group" role="group" aria-label="Tipo de caso">

                <a asp-action="Index"
                   asp-route-tab="tramites"
                   class="btn btn-sm @(vista == "todos" ? "btn-agua" : "btn-outline-primary")">
                    Todos (@(abiertosTramites + abiertosAverias))
                </a>

                <a asp-action="Index"
                   asp-route-tab="tramites"
                   asp-route-vista="tramites"
                   class="btn btn-sm @(vista == "tramites" ? "btn-agua" : "btn-outline-primary")">
                    Trámites (@abiertosTramites)
                </a>

                <a asp-action="Index"
                   asp-route-tab="tramites"
                   asp-route-vista="averias"
                   class="btn btn-sm @(vista == "averias" ? "btn-agua" : "btn-outline-primary")">
                    Averías (@abiertosAverias)
                </a>

            </div>
        </div>

        <p class="mpa-muted mb-3">
            Por defecto se muestran solo los casos abiertos. Los trámites se evalúan en
            Evaluación de trámites; las averías se atienden en Averías.
        </p>

        <form asp-action="Index"
              method="get"
              class="row g-2 align-items-end">

            <input type="hidden"
                   name="tab"
                   value="tramites" />

            <input type="hidden"
                   name="vista"
                   value="@vista" />

            <div class="col-md-4">

                <label for="f-buscar" class="form-label">
                    Buscar
                </label>

                <input id="f-buscar"
                       name="buscar"
                       value="@buscarFiltro"
                       class="form-control"
                       placeholder="Tipo, N.° de trámite / caso o solicitante" />
            </div>

            <div class="col-md-3">

                <label for="f-estado" class="form-label">
                    Estado
                </label>

                <select id="f-estado"
                        name="estado"
                        class="form-select">

                    <option value="">Abiertos</option>

                    @foreach (var estadoOpcion in new[]
                    {
                        "Pendiente",
                        "En proceso",
                        "Aprobado",
                        "Rechazado",
                        "Resuelta"
                    })
                    {
                        if (estadoFiltroActual == estadoOpcion)
                        {
                            <option value="@estadoOpcion" selected>
                                @estadoOpcion
                            </option>
                        }
                        else
                        {
                            <option value="@estadoOpcion">
                                @estadoOpcion
                            </option>
                        }
                    }

                </select>
            </div>

            <div class="col-md-2">

                <div class="form-check mt-4">

                    <input id="f-todos"
                           type="checkbox"
                           name="todos"
                           value="true"
                           checked="@verTodos"
                           class="form-check-input" />

                    <label class="form-check-label"
                           for="f-todos">
                        Incluir cerrados
                    </label>

                </div>
            </div>

            <div class="col-md-3 d-flex gap-2">

                <button type="submit"
                        class="btn btn-agua flex-fill">
                    Aplicar filtros
                </button>

                <a asp-action="Index"
                   asp-route-tab="tramites"
                   class="btn btn-outline-secondary">
                    Limpiar
                </a>

            </div>
        </form>
    </div>

    <div class="panel">

        <div class="d-flex justify-content-between align-items-center mb-2">

            <span class="mpa-muted">
                @if (filasTramites > 0)
                {
                    <text>Mostrando @desdeTramites–@hastaTramites de @filasTramites</text>
                }
                else
                {
                    <text>0 resultados</text>
                }
            </span>

        </div>

        <div class="table-responsive">

            <table class="table table-asada align-middle mb-0">

                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>N.°</th>
                        <th>Solicitante</th>
                        <th>Estado</th>
                        <th>Canal</th>
                        <th>Fecha</th>
                        <th>Acción</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (DataRow t in tramites.Rows)
                    {
                        bool esAveria = Texto(t, "TipoRegistro") == "Averia";
                        bool tieneSolicitud = Texto(t, "TieneSolicitud") == "1";

                        string numero = string.IsNullOrWhiteSpace(Texto(t, "NumeroTramite"))
                            ? "#" + Texto(t, "IdRegistro")
                            : Texto(t, "NumeroTramite");

                        string estadoFila = Texto(t, "Estado");

                        string claseEstado = estadoFila switch
                        {
                            "Aprobado" => "bg-success",
                            "Resuelta" => "bg-success",
                            "Cerrada" => "bg-success",
                            "Rechazado" => "bg-danger",
                            "En proceso" => "bg-info text-dark",
                            _ => "bg-warning text-dark"
                        };

                        <tr class="@(esAveria ? "table-warning" : "")">

                            <td>
                                @(esAveria ? "⚠ " + Texto(t, "Tipo") : Texto(t, "Tipo"))
                            </td>

                            <td class="text-nowrap">@numero</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(Texto(t, "Solicitante"))
                                    ? "—"
                                    : Texto(t, "Solicitante"))
                            </td>

                            <td>
                                <span class="badge @claseEstado">
                                    @estadoFila
                                </span>
                            </td>

                            <td>@Texto(t, "CanalOrigen")</td>
                            <td>@Fecha(t, "FechaRecepcion")</td>

                            <td class="mpa-actions">

                                @if (esAveria)
                                {
                                    <a asp-controller="Averias"
                                       asp-action="Detalle"
                                       asp-route-id="@Texto(t, "IdRegistro")"
                                       class="btn btn-sm btn-agua">

                                        <i class="bi bi-clipboard-check"></i>
                                        @(estadoFila == "Resuelta" ? "Ver detalle" : "Atender")
                                    </a>

                                    <a asp-action="Index"
                                       asp-route-tab="averias"
                                       asp-route-buscar="@numero"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-tools"></i>
                                        Orden
                                    </a>
                                }
                                else if (tieneSolicitud)
                                {
                                    <a asp-controller="EvaluacionTramites"
                                       asp-action="Detalle"
                                       asp-route-id="@Texto(t, "IdRegistro")"
                                       class="btn btn-sm btn-agua">

                                        <i class="bi bi-clipboard-check"></i>
                                        @(estadoFila == "Pendiente" ? "Evaluar" : "Ver detalle")
                                    </a>
                                }
                                else
                                {
                                    <span class="mpa-muted d-inline-block me-2">
                                        Sin solicitud en línea
                                    </span>
                                }

                                <button type="button"
                                        class="btn btn-sm btn-outline-primary js-tramite-canal"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalTramite"
                                        data-id="@Texto(t, "IdRegistro")"
                                        data-tipoorigen="@Texto(t, "TipoRegistro")"
                                        data-tipo="@Texto(t, "Tipo")"
                                        data-numero="@numero"
                                        data-canal="@Texto(t, "CanalOrigen")">

                                    <i class="bi bi-telephone-inbound"></i>
                                    Canal
                                </button>

                            </td>

                        </tr>
                    }

                    @if (tramites.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                No hay casos que coincidan con los filtros.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

        <!-- PAGINACIÓN -->

        @if (paginasTramites > 1)
        {
            <nav aria-label="Páginas de la bandeja"
                 class="mt-3">

                <ul class="pagination pagination-sm flex-wrap mb-0">

                    <li class="page-item @(paginaTramites == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@rutaPaginaTramites(paginaTramites - 1)">
                            Anterior
                        </a>
                    </li>

                    @for (int i = Math.Max(1, paginaTramites - 2);
                          i <= Math.Min(paginasTramites, paginaTramites + 2);
                          i++)
                    {
                        <li class="page-item @(i == paginaTramites ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-all-route-data="@rutaPaginaTramites(i)">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(paginaTramites == paginasTramites ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@rutaPaginaTramites(paginaTramites + 1)">
                            Siguiente
                        </a>
                    </li>

                </ul>

                <div class="mpa-muted mt-1">
                    Página @paginaTramites de @paginasTramites
                </div>

            </nav>
        }
    </div>

    <!-- MODAL CANAL DE INGRESO -->

    <div class="modal fade"
         id="modalTramite"
         tabindex="-1"
         aria-labelledby="tituloModalTramite"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <form asp-action="Canal"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5 class="modal-title mpa-modal-title"
                            id="tituloModalTramite">
                            Canal de ingreso
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>

                    </div>

                    <div class="modal-body">

                        <p class="mpa-muted" id="t-detalle"></p>

                        <input id="t-id"
                               name="idRegistroOrigen"
                               type="hidden" />

                        <input id="t-origen"
                               name="tipoOrigen"
                               type="hidden" />

                        <label for="t-canal" class="form-label">
                            ¿Por dónde ingresó?
                        </label>

                        <select id="t-canal"
                                name="canalOrigen"
                                class="form-select">

                            <option>Web</option>
                            <option>Presencial</option>
                            <option>Teléfono</option>
                            <option>Correo</option>

                        </select>

                        <p class="mpa-muted mt-2 mb-0">
                            El estado del trámite se cambia en Evaluación de trámites.
                            El estado de una avería se cambia en Atender
                            o al asignar / cerrar su orden en Averías · MPA-05.
                        </p>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button class="btn btn-agua">
                            Guardar canal
                        </button>

                    </div>

                </form>
            </div>
        </div>
    </div>
}

<!-- ====================================== -->
<!-- MPA-05: AVERÍAS -->
<!-- ====================================== -->

@if (tab == "averias")
{
    var resumenAverias = (DataTable)ViewBag.ResumenAverias;
    var categorias = (DataTable)ViewBag.Categorias;

    DataRow? resumen = resumenAverias.Rows.Count > 0
        ? resumenAverias.Rows[0]
        : null;

    Func<string, string> ResumenValor = columna =>
        resumen == null || string.IsNullOrWhiteSpace(Texto(resumen, columna))
            ? "0"
            : Texto(resumen, columna);

    string? buscarAveria = ViewBag.Buscar as string;
    string? estadoAveriaFiltro = ViewBag.Estado as string;
    int? categoriaFiltro = ViewBag.Categoria as int?;
    int? fontaneroFiltro = ViewBag.Fontanero as int?;
    bool incluirResueltas = (ViewBag.Todos as bool?) ?? false;
    bool verHistorial = (ViewBag.Historial as bool?) ?? false;
    bool abrirFontaneros = (ViewBag.Abrir as string) == "fontaneros";

    int paginaAverias = (int)(ViewBag.Pagina ?? 1);
    int paginasAverias = (int)(ViewBag.TotalPaginas ?? 1);
    int filasAverias = (int)(ViewBag.TotalFilas ?? 0);

    int paginaOrdenes = (int)(ViewBag.PaginaOrdenes ?? 1);
    int paginasOrdenes = (int)(ViewBag.TotalPaginasOrdenes ?? 1);
    int filasOrdenes = (int)(ViewBag.TotalOrdenes ?? 0);

    int fontanerosActivos = fontaneros.Rows.Cast<DataRow>()
        .Count(fila => Texto(fila, "Activo") == "True");

    int ordenesAbiertasTotal = fontaneros.Rows.Cast<DataRow>()
        .Sum(fila => int.TryParse(Texto(fila, "OrdenesAbiertas"), out var n) ? n : 0);

    var filtrosAverias = new Dictionary<string, string> { ["tab"] = "averias" };

    if (!string.IsNullOrWhiteSpace(buscarAveria)) { filtrosAverias["buscar"] = buscarAveria; }
    if (!string.IsNullOrWhiteSpace(estadoAveriaFiltro)) { filtrosAverias["estado"] = estadoAveriaFiltro; }
    if (categoriaFiltro.HasValue) { filtrosAverias["categoria"] = categoriaFiltro.Value.ToString(); }
    if (fontaneroFiltro.HasValue) { filtrosAverias["fontanero"] = fontaneroFiltro.Value.ToString(); }
    if (incluirResueltas) { filtrosAverias["todos"] = "true"; }
    if (verHistorial) { filtrosAverias["historial"] = "true"; }

    Func<int, int, Dictionary<string, string>> rutaAverias = (pagAverias, pagOrdenes) =>
        new Dictionary<string, string>(filtrosAverias)
        {
            ["pagina"] = pagAverias.ToString(),
            ["paginaOrdenes"] = pagOrdenes.ToString()
        };

    var rutaHistorial = new Dictionary<string, string>(filtrosAverias);

    if (verHistorial)
    {
        rutaHistorial.Remove("historial");
    }
    else
    {
        rutaHistorial["historial"] = "true";
    }

    int desdeAverias = filasAverias == 0 ? 0 : ((paginaAverias - 1) * 20) + 1;
    int hastaAverias = Math.Min(paginaAverias * 20, filasAverias);

    <!-- FONTANEROS (PLEGABLE) -->

    <div class="panel mb-3">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

            <div>
                <h3 class="mpa-subtitle mb-0">
                    Fontaneros
                </h3>

                <span class="mpa-muted">
                    Activos: @fontanerosActivos de @fontaneros.Rows.Count ·
                    Órdenes abiertas: @ordenesAbiertasTotal
                </span>
            </div>

            <div class="d-flex gap-2">

                <button type="button"
                        class="btn btn-outline-primary"
                        data-bs-toggle="collapse"
                        data-bs-target="#panelFontaneros"
                        aria-expanded="@(abrirFontaneros ? "true" : "false")"
                        aria-controls="panelFontaneros">

                    <i class="bi bi-people"></i>
                    Ver / administrar
                </button>

                <button type="button"
                        class="btn btn-agua js-fontanero-nuevo"
                        data-bs-toggle="modal"
                        data-bs-target="#modalFontanero">

                    <i class="bi bi-person-plus"></i>
                    Nuevo fontanero
                </button>

            </div>
        </div>

        <div id="panelFontaneros"
             class="collapse @(abrirFontaneros ? "show" : "")">

            <div class="table-responsive mt-3">

                <table class="table table-asada align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th>Órdenes abiertas</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (DataRow f in fontaneros.Rows)
                        {
                            bool activo = Texto(f, "Activo") == "True";

                            <tr class="@(activo ? "" : "text-muted")">

                                <td class="fw-semibold">@Texto(f, "Nombre")</td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(Texto(f, "Telefono"))
                                        ? "—"
                                        : Texto(f, "Telefono"))
                                </td>

                                <td>
                                    <span class="badge @(activo ? "bg-success" : "bg-secondary")">
                                        @(activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>

                                <td>
                                    <a asp-action="Index"
                                       asp-route-tab="averias"
                                       asp-route-fontanero="@Texto(f, "IdFontanero")">
                                        @Texto(f, "OrdenesAbiertas")
                                    </a>
                                </td>

                                <td class="mpa-actions">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary js-fontanero-editar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalFontanero"
                                            data-id="@Texto(f, "IdFontanero")"
                                            data-nombre="@Texto(f, "Nombre")"
                                            data-telefono="@Texto(f, "Telefono")"
                                            data-activo="@(activo ? "true" : "false")">

                                        <i class="bi bi-pencil-square"></i>
                                        Editar
                                    </button>

                                    <form asp-action="ActualizarFontanero"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('@(activo ? "¿Desactivar este fontanero? Ya no aparecerá para asignar órdenes." : "¿Activar este fontanero?")');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="idFontanero"
                                               value="@Texto(f, "IdFontanero")" />

                                        <input type="hidden"
                                               name="nombre"
                                               value="@Texto(f, "Nombre")" />

                                        <input type="hidden"
                                               name="telefono"
                                               value="@Texto(f, "Telefono")" />

                                        <input type="hidden"
                                               name="activo"
                                               value="@(activo ? "false" : "true")" />

                                        <button type="submit"
                                                class="btn btn-sm @(activo ? "btn-outline-danger" : "btn-outline-success")">
                                            @(activo ? "Desactivar" : "Activar")
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                        @if (fontaneros.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="5">
                                    No hay fontaneros registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>
        </div>
    </div>

    <!-- CONTADORES (CLIC PARA FILTRAR) -->

    <div class="row g-3 mb-3">

        <div class="col-6 col-lg-3">
            <a class="mpa-kpi mpa-kpi-warning"
               asp-action="Index"
               asp-route-tab="averias"
               asp-route-estado="Pendiente">

                <span class="mpa-kpi-num">@ResumenValor("Pendientes")</span>
                <span class="mpa-kpi-label">Pendientes</span>
            </a>
        </div>

        <div class="col-6 col-lg-3">
            <a class="mpa-kpi mpa-kpi-info"
               asp-action="Index"
               asp-route-tab="averias"
               asp-route-estado="En proceso">

                <span class="mpa-kpi-num">@ResumenValor("EnProceso")</span>
                <span class="mpa-kpi-label">En proceso</span>
            </a>
        </div>

        <div class="col-6 col-lg-3">
            <a class="mpa-kpi mpa-kpi-danger"
               asp-action="Index"
               asp-route-tab="averias"
               asp-route-fontanero="0">

                <span class="mpa-kpi-num">@ResumenValor("SinFontanero")</span>
                <span class="mpa-kpi-label">Abiertas sin fontanero</span>
            </a>
        </div>

        <div class="col-6 col-lg-3">
            <a class="mpa-kpi mpa-kpi-success"
               asp-action="Index"
               asp-route-tab="averias"
               asp-route-estado="Resuelta">

                <span class="mpa-kpi-num">@ResumenValor("Resueltas")</span>
                <span class="mpa-kpi-label">Resueltas (histórico)</span>
            </a>
        </div>

    </div>

    <!-- AVERÍAS: FILTROS Y LISTA -->

    <div class="panel mb-3">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">

            <h3 class="mpa-subtitle mb-0">
                Averías reportadas
            </h3>

            <a asp-controller="Averias"
               asp-action="Index"
               class="btn btn-outline-primary">

                <i class="bi bi-box-arrow-up-right"></i>
                Ir a Averías
            </a>

        </div>

        <p class="mpa-muted mb-3">
            Por defecto se ocultan las resueltas. Al asignar un fontanero, una avería
            Pendiente pasa a En proceso; al cerrar la orden como resuelta, pasa a Resuelta.
        </p>

        <form asp-action="Index"
              method="get"
              class="row g-2 align-items-end mb-3">

            <input type="hidden"
                   name="tab"
                   value="averias" />

            <div class="col-md-3">

                <label for="av-buscar" class="form-label">
                    Buscar
                </label>

                <input id="av-buscar"
                       name="buscar"
                       value="@buscarAveria"
                       class="form-control"
                       placeholder="Caso, abonado, ubicación…" />
            </div>

            <div class="col-md-2">

                <label for="av-estado" class="form-label">
                    Estado
                </label>

                <select id="av-estado"
                        name="estado"
                        class="form-select">

                    <option value="">Abiertas</option>

                    @foreach (var estadoOpcion in new[] { "Pendiente", "En proceso", "Resuelta" })
                    {
                        if (estadoAveriaFiltro == estadoOpcion)
                        {
                            <option value="@estadoOpcion" selected>@estadoOpcion</option>
                        }
                        else
                        {
                            <option value="@estadoOpcion">@estadoOpcion</option>
                        }
                    }

                </select>
            </div>

            <div class="col-md-2">

                <label for="av-categoria" class="form-label">
                    Categoría
                </label>

                <select id="av-categoria"
                        name="categoria"
                        class="form-select">

                    <option value="">Todas</option>

                    @foreach (DataRow c in categorias.Rows)
                    {
                        if (categoriaFiltro?.ToString() == Texto(c, "IdCategoriaAveria"))
                        {
                            <option value="@Texto(c, "IdCategoriaAveria")" selected>
                                @Texto(c, "Nombre")
                            </option>
                        }
                        else
                        {
                            <option value="@Texto(c, "IdCategoriaAveria")">
                                @Texto(c, "Nombre")
                            </option>
                        }
                    }

                </select>
            </div>

            <div class="col-md-2">

                <label for="av-fontanero" class="form-label">
                    Fontanero
                </label>

                <select id="av-fontanero"
                        name="fontanero"
                        class="form-select">

                    <option value="">Todos</option>

                    @if (fontaneroFiltro == 0)
                    {
                        <option value="0" selected>Sin fontanero</option>
                    }
                    else
                    {
                        <option value="0">Sin fontanero</option>
                    }

                    @foreach (DataRow f in fontaneros.Rows)
                    {
                        if (fontaneroFiltro?.ToString() == Texto(f, "IdFontanero"))
                        {
                            <option value="@Texto(f, "IdFontanero")" selected>
                                @Texto(f, "Nombre")
                            </option>
                        }
                        else
                        {
                            <option value="@Texto(f, "IdFontanero")">
                                @Texto(f, "Nombre")
                            </option>
                        }
                    }

                </select>
            </div>

            <div class="col-md-1">

                <div class="form-check mt-4">

                    <input id="av-todos"
                           type="checkbox"
                           name="todos"
                           value="true"
                           checked="@incluirResueltas"
                           class="form-check-input" />

                    <label class="form-check-label"
                           for="av-todos">
                        Resueltas
                    </label>

                </div>
            </div>

            <div class="col-md-2 d-flex gap-2">

                <button type="submit"
                        class="btn btn-agua flex-fill">
                    Filtrar
                </button>

                <a asp-action="Index"
                   asp-route-tab="averias"
                   class="btn btn-outline-secondary">
                    Limpiar
                </a>

            </div>
        </form>

        <div class="mpa-muted mb-2">
            @if (filasAverias > 0)
            {
                <text>Mostrando @desdeAverias–@hastaAverias de @filasAverias</text>
            }
            else
            {
                <text>0 resultados</text>
            }
        </div>

        <div class="table-responsive">

            <table class="table table-asada align-middle mb-0">

                <thead>
                    <tr>
                        <th>Caso</th>
                        <th>Categoría</th>
                        <th>Abonado</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Fontanero</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (DataRow a in averias.Rows)
                    {
                        string estadoAveria = Texto(a, "EstadoReporte");

                        string claseAveria = estadoAveria switch
                        {
                            "Resuelta" => "bg-success",
                            "En proceso" => "bg-info text-dark",
                            _ => "bg-warning text-dark"
                        };

                        bool ordenAbierta =
                            !string.IsNullOrWhiteSpace(Texto(a, "IdOrden")) &&
                            Texto(a, "EstadoOrden") != "Cerrada";

                        <tr>

                            <td class="text-nowrap fw-semibold">
                                @Texto(a, "NumeroCaso")

                                <div class="mpa-muted">
                                    @Fecha(a, "FechaReporte")
                                </div>
                            </td>

                            <td>@Texto(a, "Categoria")</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(Texto(a, "Abonado"))
                                    ? "—"
                                    : Texto(a, "Abonado"))
                            </td>

                            <td>
                                <div class="mpa-long">
                                    @Texto(a, "Descripcion")
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Texto(a, "Ubicacion")))
                                {
                                    <div class="mpa-muted mpa-long">
                                        <i class="bi bi-geo-alt"></i>
                                        @Texto(a, "Ubicacion")
                                    </div>
                                }
                            </td>

                            <td>
                                <span class="badge @claseAveria">
                                    @estadoAveria
                                </span>
                            </td>

                            <td>
                                @if (!ordenAbierta)
                                {
                                    <span class="mpa-muted">Sin asignar</span>
                                }
                                else
                                {
                                    @Texto(a, "Fontanero")

                                    <div class="mpa-muted">
                                        Orden: @Texto(a, "EstadoOrden")
                                    </div>
                                }
                            </td>

                            <td class="mpa-actions">

                                <a asp-controller="Averias"
                                   asp-action="Detalle"
                                   asp-route-id="@Texto(a, "IdAveria")"
                                   class="btn btn-sm btn-agua">

                                    <i class="bi bi-clipboard-check"></i>
                                    @(estadoAveria == "Resuelta" ? "Ver detalle" : "Atender")
                                </a>

                                @if (estadoAveria != "Resuelta")
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary js-averia-asignar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalAsignar"
                                            data-id="@Texto(a, "IdAveria")"
                                            data-caso="@Texto(a, "NumeroCaso")"
                                            data-descripcion="@Texto(a, "Descripcion")"
                                            data-fontanero="@(ordenAbierta ? Texto(a, "IdFontanero") : "")"
                                            data-observaciones="@(ordenAbierta ? Texto(a, "Observaciones") : "")">

                                        <i class="bi bi-tools"></i>
                                        @(ordenAbierta ? "Reasignar" : "Asignar fontanero")
                                    </button>
                                }

                            </td>

                        </tr>
                    }

                    @if (averias.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                No hay averías que coincidan con los filtros.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>

        @if (paginasAverias > 1)
        {
            <nav aria-label="Páginas de averías"
                 class="mt-3">

                <ul class="pagination pagination-sm flex-wrap mb-0">

                    <li class="page-item @(paginaAverias == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@rutaAverias(paginaAverias - 1, paginaOrdenes)">
                            Anterior
                        </a>
                    </li>

                    @for (int i = Math.Max(1, paginaAverias - 2);
                          i <= Math.Min(paginasAverias, paginaAverias + 2);
                          i++)
                    {
                        <li class="page-item @(i == paginaAverias ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-all-route-data="@rutaAverias(i, paginaOrdenes)">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(paginaAverias == paginasAverias ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@rutaAverias(paginaAverias + 1, paginaOrdenes)">
                            Siguiente
                        </a>
                    </li>

                </ul>

                <div class="mpa-muted mt-1">
                    Página @paginaAverias de @paginasAverias
                </div>

            </nav>
        }
    </div>

    <!-- SEGUIMIENTO DE ÓRDENES -->

    <div class="panel">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

            <div>
                <h3 class="mpa-subtitle mb-0">
                    Seguimiento de órdenes
                </h3>

                <span class="mpa-muted">
                    @(verHistorial
                        ? "Historial completo: " + filasOrdenes + " órdenes"
                        : "Órdenes abiertas: " + filasOrdenes)
                </span>
            </div>

            <a class="btn btn-sm btn-outline-primary"
               asp-action="Index"
               asp-all-route-data="rutaHistorial">

                <i class="bi bi-clock-history"></i>
                @(verHistorial ? "Ver solo abiertas" : "Ver historial de órdenes")
            </a>

        </div>

        <div class="table-responsive">

            <table class="table table-asada align-middle mb-0">

                <thead>
                    <tr>
                        <th>Orden</th>
                        <th>Avería</th>
                        <th>Estado de la avería</th>
                        <th>Fontanero</th>
                        <th>Estado de la orden</th>
                        <th>Acción</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (DataRow o in ordenes.Rows)
                    {
                        bool ordenCerrada = Texto(o, "Estado") == "Cerrada";
                        bool averiaResuelta = Texto(o, "EstadoAveria") == "Resuelta";

                        <tr>
                            <td>#@Texto(o, "IdOrden")</td>

                            <td class="text-nowrap">
                                <a asp-controller="Averias"
                                   asp-action="Detalle"
                                   asp-route-id="@Texto(o, "IdAveria")">
                                    @Texto(o, "NumeroCaso")
                                </a>
                            </td>

                            <td>@Texto(o, "EstadoAveria")</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(Texto(o, "Fontanero"))
                                    ? "Sin asignar"
                                    : Texto(o, "Fontanero"))
                            </td>

                            <td>@Texto(o, "Estado")</td>

                            <td>
                                @if (ordenCerrada)
                                {
                                    <span class="text-success">
                                        Cerrada
                                    </span>
                                }
                                else
                                {
                                    if (averiaResuelta)
                                    {
                                        <div class="mpa-muted mb-1">
                                            La avería ya está resuelta; cierra la orden.
                                        </div>
                                    }

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary js-orden-seguimiento"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalSeguimiento"
                                            data-id="@Texto(o, "IdOrden")"
                                            data-observaciones="@Texto(o, "Observaciones")">

                                        Actualizar seguimiento
                                    </button>
                                }
                            </td>
                        </tr>
                    }

                    @if (ordenes.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                @(verHistorial
                                    ? "Todavía no hay órdenes de trabajo."
                                    : "No hay órdenes abiertas.")
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>

        @if (paginasOrdenes > 1)
        {
            <nav aria-label="Páginas de órdenes"
                 class="mt-3">

                <ul class="pagination pagination-sm flex-wrap mb-0">

                    <li class="page-item @(paginaOrdenes == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@rutaAverias(paginaAverias, paginaOrdenes - 1)">
                            Anterior
                        </a>
                    </li>

                    @for (int i = Math.Max(1, paginaOrdenes - 2);
                          i <= Math.Min(paginasOrdenes, paginaOrdenes + 2);
                          i++)
                    {
                        <li class="page-item @(i == paginaOrdenes ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-all-route-data="@rutaAverias(paginaAverias, i)">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(paginaOrdenes == paginasOrdenes ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@rutaAverias(paginaAverias, paginaOrdenes + 1)">
                            Siguiente
                        </a>
                    </li>

                </ul>

                <div class="mpa-muted mt-1">
                    Página @paginaOrdenes de @paginasOrdenes
                </div>

            </nav>
        }
    </div>

    <!-- MODAL ASIGNAR / REASIGNAR -->

    <div class="modal fade"
         id="modalAsignar"
         tabindex="-1"
         aria-labelledby="tituloModalAsignar"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <form asp-action="Asignar" method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5 id="tituloModalAsignar"
                            class="modal-title mpa-modal-title">
                            Gestionar orden
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>
                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               id="a-id"
                               name="idAveria" />

                        <p class="mpa-muted" id="a-descripcion"></p>

                        <label for="a-fontanero" class="form-label">
                            Fontanero responsable
                        </label>

                        <select id="a-fontanero"
                                name="idFontanero"
                                class="form-select mb-3"
                                required>

                            <option value="">Selecciona un fontanero</option>

                            @foreach (DataRow f in fontaneros.Rows)
                            {
                                if (Texto(f, "Activo") == "True")
                                {
                                    <option value="@Texto(f, "IdFontanero")">
                                        @Texto(f, "Nombre")
                                    </option>
                                }
                            }

                        </select>

                        <label for="a-obs" class="form-label">
                            Observaciones
                        </label>

                        <textarea id="a-obs"
                                  name="observaciones"
                                  maxlength="2000"
                                  rows="3"
                                  class="form-control"></textarea>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button class="btn btn-agua">
                            Guardar asignación
                        </button>

                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- MODAL SEGUIMIENTO -->

    <div class="modal fade"
         id="modalSeguimiento"
         tabindex="-1"
         aria-labelledby="tituloModalSeguimiento"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <form asp-action="RevisarOrden" method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5 id="tituloModalSeguimiento"
                            class="modal-title mpa-modal-title">
                            Actualizar seguimiento
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>
                    </div>

                    <div class="modal-body">

                        <input id="o-id"
                               type="hidden"
                               name="idOrden" />

                        <label for="o-resuelto" class="form-label">
                            ¿Se resolvió?
                        </label>

                        <select id="o-resuelto"
                                name="seResolvio"
                                class="form-select mb-3">

                            <option value="false">
                                No, mantener abierta
                            </option>

                            <option value="true">
                                Sí, cerrar orden (la avería pasa a Resuelta)
                            </option>

                        </select>

                        <label for="o-obs" class="form-label">
                            Observaciones
                        </label>

                        <textarea id="o-obs"
                                  name="observaciones"
                                  class="form-control"
                                  maxlength="2000"
                                  rows="4"></textarea>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button class="btn btn-agua">
                            Guardar seguimiento
                        </button>

                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- MODAL FONTANERO: NUEVO / EDITAR -->

    <div class="modal fade"
         id="modalFontanero"
         tabindex="-1"
         aria-labelledby="tituloModalFontanero"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <form id="formFontanero"
                      asp-action="NuevoFontanero"
                      method="post"
                      data-url-nuevo="@Url.Action("NuevoFontanero", "PanelAdministrativo")"
                      data-url-editar="@Url.Action("ActualizarFontanero", "PanelAdministrativo")">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5 id="tituloModalFontanero"
                            class="modal-title mpa-modal-title">
                            Nuevo fontanero
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>

                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               id="f-id"
                               name="idFontanero"
                               disabled />

                        <label for="f-nombre" class="form-label">
                            Nombre completo
                        </label>

                        <input id="f-nombre"
                               name="nombre"
                               class="form-control mb-3"
                               required
                               maxlength="200" />

                        <label for="f-telefono" class="form-label">
                            Teléfono
                        </label>

                        <input id="f-telefono"
                               name="telefono"
                               class="form-control mb-3"
                               maxlength="30" />

                        <div id="f-bloque-activo"
                             class="d-none">

                            <label for="f-activo" class="form-label">
                                Estado
                            </label>

                            <select id="f-activo"
                                    name="activo"
                                    class="form-select"
                                    disabled>

                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>

                            </select>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button class="btn btn-agua">
                            Guardar
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>
}

<!-- ====================================== -->
<!-- MPA-06: ABONADOS -->
<!-- ====================================== -->

@if (tab == "abonados")
{
    <div class="panel">

        <h3 class="mpa-subtitle mb-3">
            Administración de abonados
        </h3>

        <div class="table-responsive">

            <table class="table table-asada align-middle mb-0">

                <thead>
                    <tr>
                        <th>NIS</th>
                        <th>N.° paja</th>
                        <th>Abonado</th>
                        <th>Correo</th>
                        <th>Estado de cuenta</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (DataRow a in abonados.Rows)
                    {
                        <tr>
                            <td>@Texto(a, "NIS")</td>
                            <td>@Texto(a, "NumeroPaja")</td>
                            <td>@Texto(a, "Nombres")</td>
                            <td>@Texto(a, "CorreoElectronico")</td>

                            <td>
                                @if (Texto(a, "PosibleMora") == "1")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Revisar mora
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sin alerta
                                    </span>
                                }
                            </td>

                            <td class="mpa-actions">

                                <a asp-action="Index"
                                   asp-route-tab="abonados"
                                   asp-route-idAbonado="@Texto(a, "IdAbonado")"
                                   class="btn btn-sm btn-outline-primary">

                                    Editar / Ver historial
                                </a>

                                <a asp-action="Index"
                                   asp-route-tab="abonados"
                                   asp-route-idAbonado="@Texto(a, "IdAbonado")"
                                   asp-fragment="contratos"
                                   class="btn btn-sm btn-outline-secondary">

                                    Contratos
                                </a>

                            </td>
                        </tr>
                    }

                    @if (abonados.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                No hay abonados registrados.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

    @if (persona != null)
    {
        <div class="modal fade"
             id="modalAbonado"
             tabindex="-1"
             aria-labelledby="tituloModalAbonado"
             aria-hidden="true">

            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

                <div class="modal-content">

                    <div class="modal-header">

                        <h5 id="tituloModalAbonado"
                            class="modal-title mpa-modal-title">

                            Abonado @Texto(persona, "NIS")
                        </h5>

                        <a class="btn-close"
                           asp-action="Index"
                           asp-route-tab="abonados"
                           aria-label="Cerrar"></a>

                    </div>

                    <div class="modal-body">

                        <ul class="nav nav-tabs mb-3"
                            id="tabsAbonado"
                            role="tablist">

                            <li class="nav-item">
                                <button type="button"
                                        class="nav-link active"
                                        id="tab-datos"
                                        data-bs-toggle="tab"
                                        data-bs-target="#panel-datos">

                                    Datos del abonado
                                </button>
                            </li>

                            <li class="nav-item">
                                <button type="button"
                                        class="nav-link"
                                        id="tab-contratos"
                                        data-bs-toggle="tab"
                                        data-bs-target="#panel-contratos">

                                    Contratos
                                </button>
                            </li>

                            <li class="nav-item">
                                <button type="button"
                                        class="nav-link"
                                        data-bs-toggle="tab"
                                        data-bs-target="#panel-historial">

                                    Historial
                                </button>
                            </li>

                        </ul>

                        <div class="tab-content">

                            <!-- DATOS DEL ABONADO -->

                            <div class="tab-pane fade show active"
                                 id="panel-datos">

                                <form asp-action="EditarAbonado"
                                      method="post"
                                      class="row g-3">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="idAbonado"
                                           value="@Texto(persona, "IdAbonado")" />

                                    <div class="col-md-4">
                                        <label class="form-label">Nombre</label>

                                        <input name="nombres"
                                               class="form-control"
                                               value="@Texto(persona, "Nombres")"
                                               maxlength="100"
                                               required />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Teléfono</label>

                                        <input name="telefono"
                                               class="form-control"
                                               value="@Texto(persona, "Telefono")"
                                               maxlength="20" />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Correo</label>

                                        <input name="correoElectronico"
                                               type="email"
                                               class="form-control"
                                               value="@Texto(persona, "CorreoElectronico")"
                                               maxlength="200"
                                               required />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Dirección</label>

                                        <input name="direccion"
                                               class="form-control"
                                               value="@Texto(persona, "Direccion")"
                                               maxlength="500"
                                               required />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">Finca</label>

                                        <input name="numeroFinca"
                                               class="form-control"
                                               value="@Texto(persona, "NumeroFinca")"
                                               maxlength="30" />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">Plano</label>

                                        <input name="numeroPlano"
                                               class="form-control"
                                               value="@Texto(persona, "NumeroPlano")"
                                               maxlength="30" />
                                    </div>

                                    <div class="col-md-4">

                                        <label class="form-label">Tarifa</label>

                                        <select name="idTarifa"
                                                class="form-select"
                                                required>

                                            @foreach (DataRow tarifa in tarifas.Rows)
                                            {
                                                if (Texto(tarifa, "IdTarifa") ==
                                                    Texto(persona, "IdTarifa"))
                                                {
                                                    <option value="@Texto(tarifa, "IdTarifa")" selected>
                                                        @Texto(tarifa, "Nombre")
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@Texto(tarifa, "IdTarifa")">
                                                        @Texto(tarifa, "Nombre")
                                                    </option>
                                                }
                                            }

                                        </select>
                                    </div>

                                    <div class="col-12">

                                        <button class="btn btn-agua">
                                            Guardar cambios
                                        </button>

                                    </div>

                                </form>
                            </div>

                            <!-- CONTRATOS -->

                            <div class="tab-pane fade"
                                 id="panel-contratos">

                                <form asp-action="RegenerarContrato"
                                      method="post"
                                      class="row g-3 mb-4">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="idAbonado"
                                           value="@Texto(persona, "IdAbonado")" />

                                    <div class="col-md-5">

                                        <label class="form-label">
                                            Versión del reglamento
                                        </label>

                                        <input class="form-control"
                                               name="versionReglamento"
                                               maxlength="100"
                                               required />
                                    </div>

                                    <div class="col-12">

                                        <label class="form-label">
                                            Texto oficial de aceptación
                                        </label>

                                        <textarea class="form-control"
                                                  name="textoReglamento"
                                                  maxlength="900"
                                                  rows="3"
                                                  required></textarea>

                                        <div class="form-text">
                                            Utiliza el texto aprobado por la ASADA.
                                        </div>

                                    </div>

                                    <div class="col-12">

                                        <button class="btn btn-agua">
                                            Generar nueva versión PDF
                                        </button>

                                    </div>

                                </form>

                                <h6 class="mpa-subtitle">
                                    Contratos anteriores
                                </h6>

                                @foreach (DataRow contrato in contratos.Rows)
                                {
                                    <div class="d-flex justify-content-between align-items-center border-bottom py-2">

                                        <span>
                                            Versión @Texto(contrato, "NumeroVersion")
                                            · @Fecha(contrato, "FechaGeneracion")
                                        </span>

                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-action="DescargarContrato"
                                           asp-route-id="@Texto(contrato, "IdContrato")">

                                            Descargar
                                        </a>

                                    </div>
                                }

                                @if (contratos.Rows.Count == 0)
                                {
                                    <p class="mpa-muted">
                                        No hay contratos anteriores.
                                    </p>
                                }

                            </div>

                            <!-- HISTORIAL -->

                            <div class="tab-pane fade"
                                 id="panel-historial">

                                <div class="table-responsive">

                                    <table class="table table-asada">

                                        <thead>
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Campo</th>
                                                <th>Valor anterior</th>
                                                <th>Valor nuevo</th>
                                            </tr>
                                        </thead>

                                        <tbody>

                                            @foreach (DataRow cambio in cambios.Rows)
                                            {
                                                <tr>
                                                    <td>
                                                        @Fecha(cambio, "FechaModificacion")
                                                    </td>
                                                    <td>
                                                        @Texto(cambio, "CampoModificado")
                                                    </td>
                                                    <td>
                                                        @Texto(cambio, "ValorAnterior")
                                                    </td>
                                                    <td>
                                                        @Texto(cambio, "ValorNuevo")
                                                    </td>
                                                </tr>
                                            }

                                            @if (cambios.Rows.Count == 0)
                                            {
                                                <tr>
                                                    <td colspan="4">
                                                        Sin modificaciones registradas.
                                                    </td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">

                        <a asp-action="Index"
                           asp-route-tab="abonados"
                           class="btn btn-outline-secondary">

                            Volver al listado
                        </a>

                    </div>

                </div>
            </div>
        </div>
    }
}

<!-- ====================================== -->
<!-- JAVASCRIPT: FORMULARIOS PRECARGADOS -->
<!-- ====================================== -->

@section Scripts {

<script>
    document.addEventListener('DOMContentLoaded', function () {

        function all(selector, fn) {
            document.querySelectorAll(selector).forEach(fn);
        }

        function set(id, value) {
            const elemento = document.getElementById(id);

            if (elemento) {
                elemento.value = value || '';
            }
        }

        function txt(id, value) {
            const elemento = document.getElementById(id);

            if (elemento) {
                elemento.textContent = value || '';
            }
        }

        // MPA-02: NUEVA NOTICIA

        all('.js-noticia-nueva', boton => {
            boton.addEventListener('click', function () {

                txt('tituloModalNoticia', 'Nueva noticia');

                set('n-id', '0');
                set('n-titulo', '');
                set('n-contenido', '');
                set('n-fecha', '');
                set('n-imagen', '');

            });
        });

        // MPA-02: EDITAR NOTICIA

        all('.js-noticia-editar', boton => {
            boton.addEventListener('click', function () {

                txt('tituloModalNoticia', 'Editar noticia');

                set('n-id', boton.dataset.id);
                set('n-titulo', boton.dataset.titulo);
                set('n-contenido', boton.dataset.contenido);
                set('n-fecha', boton.dataset.vigencia);
                set('n-imagen', '');

            });
        });

        // MPA-03: EDITAR DOCUMENTO

        all('.js-doc-editar', boton => {
            boton.addEventListener('click', function () {

                set('d-id', boton.dataset.id);
                set('d-titulo', boton.dataset.titulo);
                set('d-tipo', boton.dataset.tipo);
                set('d-descripcion', boton.dataset.descripcion);

            });
        });

        // MPA-03: NUEVO DOCUMENTO

        all('.js-version-nueva', boton => {
            boton.addEventListener('click', function () {

                txt('tituloModalVersion', 'Crear documento');

                set('v-id', '0');
                set('v-titulo', '');
                set('v-tipo', 'Ficha institucional');

                document.getElementById('v-titulo').readOnly = false;
                document.getElementById('v-tipo').disabled = false;

            });
        });

        // MPA-03: NUEVA VERSIÓN EXISTENTE

        all('.js-version-existente', boton => {
            boton.addEventListener('click', function () {

                txt(
                    'tituloModalVersion',
                    'Nueva versión de ' + boton.dataset.titulo
                );

                set('v-id', boton.dataset.id);
                set('v-titulo', boton.dataset.titulo);
                set('v-tipo', boton.dataset.tipo);

                document.getElementById('v-titulo').readOnly = true;
                document.getElementById('v-tipo').disabled = false;

            });
        });

        // MPA-04: CANAL DE INGRESO (TRÁMITE O AVERÍA)

        all('.js-tramite-canal', boton => {
            boton.addEventListener('click', function () {

                set('t-id', boton.dataset.id);
                set('t-origen', boton.dataset.tipoorigen);

                set(
                    't-canal',
                    boton.dataset.canal === 'No registrado'
                        ? 'Web'
                        : boton.dataset.canal
                );

                txt(
                    't-detalle',
                    boton.dataset.tipo + ' · ' + boton.dataset.numero
                );

            });
        });

        // MPA-05: NUEVO FONTANERO

        all('.js-fontanero-nuevo', boton => {
            boton.addEventListener('click', function () {

                const formulario =
                    document.getElementById('formFontanero');

                formulario.action = formulario.dataset.urlNuevo;

                txt('tituloModalFontanero', 'Nuevo fontanero');

                set('f-id', '');
                set('f-nombre', '');
                set('f-telefono', '');

                document.getElementById('f-id').disabled = true;
                document.getElementById('f-activo').disabled = true;

                document.getElementById('f-bloque-activo')
                    .classList.add('d-none');

            });
        });

        // MPA-05: EDITAR FONTANERO

        all('.js-fontanero-editar', boton => {
            boton.addEventListener('click', function () {

                const formulario =
                    document.getElementById('formFontanero');

                formulario.action = formulario.dataset.urlEditar;

                txt('tituloModalFontanero', 'Editar fontanero');

                set('f-id', boton.dataset.id);
                set('f-nombre', boton.dataset.nombre);
                set('f-telefono', boton.dataset.telefono);
                set('f-activo', boton.dataset.activo);

                document.getElementById('f-id').disabled = false;
                document.getElementById('f-activo').disabled = false;

                document.getElementById('f-bloque-activo')
                    .classList.remove('d-none');

            });
        });

        // MPA-05: GESTIONAR ORDEN

        all('.js-averia-asignar', boton => {
            boton.addEventListener('click', function () {

                set('a-id', boton.dataset.id);
                set('a-fontanero', boton.dataset.fontanero);
                set('a-obs', boton.dataset.observaciones);

                txt(
                    'a-descripcion',
                    boton.dataset.caso +
                    ' — ' + boton.dataset.descripcion
                );

            });
        });

        // MPA-05: SEGUIMIENTO

        all('.js-orden-seguimiento', boton => {
            boton.addEventListener('click', function () {

                set('o-id', boton.dataset.id);
                set('o-obs', boton.dataset.observaciones);
                set('o-resuelto', 'false');

            });
        });

        // MPA-06: ABRIR AUTOMÁTICAMENTE EL ABONADO

        const modalAbonado =
            document.getElementById('modalAbonado');

        if (modalAbonado && window.bootstrap) {

            new bootstrap.Modal(modalAbonado).show();

            if (window.location.hash === '#contratos') {

                const pestaña =
                    document.getElementById('tab-contratos');

                if (pestaña) {
                    bootstrap.Tab.getOrCreateInstance(pestaña).show();
                }
            }
        }

    });
</script>

}