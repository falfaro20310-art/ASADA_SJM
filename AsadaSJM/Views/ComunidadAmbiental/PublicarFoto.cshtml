
@model AsadaSJM.Models.FotoProyectoAmbiental

@{
    ViewData["Title"] = "Publicar fotografía ambiental";
    Layout = "_Layout";
}

<div class="container-fluid" style="max-width:850px;">

    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-4">

            <h1 class="h3 fw-bold" style="color:#004A99;">
                Publicar fotografía de un proyecto ambiental
            </h1>

            <p class="text-muted">
                MGA-05: la fotografía quedará visible
                para los visitantes.
            </p>

            <form asp-action="PublicarFoto"
                  method="post"
                  enctype="multipart/form-data"
                  novalidate>

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="mb-3">

                    <label asp-for="Titulo"
                           class="form-label fw-semibold">

                        Nombre del proyecto *

                    </label>

                    <input asp-for="Titulo"
                           class="form-control"
                           maxlength="150"
                           required />

                    <span asp-validation-for="Titulo"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold"
                           for="imagen">

                        Fotografía *

                    </label>

                    <input class="form-control"
                           type="file"
                           name="imagen"
                           id="imagen"
                           accept="image/jpeg,image/png,image/webp"
                           required />

                    @Html.ValidationMessage(
                        "imagen",
                        null,
                        new { @class = "text-danger" })

                    <div class="form-text">
                        JPG, PNG o WEBP, máximo 5 MB.
                    </div>

                </div>

                <button type="submit"
                        class="btn text-white"
                        style="background:#2D5A27;">

                    Publicar fotografía

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Cancelar

                </a>

            </form>

        </div>

    </div>

</div>
