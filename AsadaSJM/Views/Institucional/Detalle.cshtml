@{
    Layout = null;

    string titulo = ViewData["Titulo"]?.ToString() ?? "Información institucional";
    string contenido = ViewData["Contenido"]?.ToString() ?? string.Empty;

    if (string.IsNullOrWhiteSpace(contenido))
    {
        contenido = "Aún no se ha registrado esta información.";
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@titulo - ASADA San José de la Montaña</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/portal.css">
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-asada">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Portal" asp-action="Index">
                <i class="bi bi-droplet-fill" style="font-size:26px;color:var(--azul-agua);"></i>
                <span class="brand">ASADA<small>San José de la Montaña</small></span>
            </a>
        </div>
    </nav>

    <section class="section">
        <div class="container" style="max-width:820px;">

            <a asp-controller="Portal" asp-action="Index" class="d-inline-block mb-3" style="font-size:14px;text-decoration:none;">
                &larr; Volver al portal
            </a>

            <h1 class="section-title mb-4">@titulo</h1>

            <p style="white-space:pre-line;line-height:1.8;font-size:15.5px;">@contenido</p>

        </div>
    </section>

    <div class="footer-bottom text-center">
        © 2026 ASADA San José de la Montaña. Todos los derechos reservados.
    </div>

</body>
</html>
