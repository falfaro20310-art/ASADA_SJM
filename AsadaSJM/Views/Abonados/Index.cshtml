
@model List<AsadaSJM.Models.Abonado>

@{
    ViewData["Title"] = "Abonados";
}

<div class="panel">

    <form method="get"
          class="d-flex justify-content-between align-items-center mb-3">

        <input type="text"
               name="buscar"
               class="form-control w-25"
               placeholder="Buscar por NIS, paja, finca, plano o dirección..." />

        <div class="d-flex gap-2">

            @if (User.IsInRole("Administrador"))
            {
                <a asp-controller="Abonados"
                   asp-action="Importar"
                   class="btn btn-outline-primary">

                    <i class="bi bi-file-earmark-arrow-up"></i>
                    Importar Excel/CSV
                </a>
            }

            <a asp-action="Create"
               class="btn btn-agua">

                <i class="bi bi-plus-lg"></i>
                Registrar abonado
            </a>
        </div>
    </form>

    @if (TempData["ImportacionExitosa"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["ImportacionExitosa"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="table-responsive">

        <table class="table table-asada mb-0">

            <thead>
                <tr>
                    <th>NIS</th>
                    <th>N° Paja</th>
                    <th>N° Finca</th>
                    <th>N° Plano</th>
                    <th>Dirección</th>
                    <th>Usuario</th>
                    <th>Tarifa</th>
                    <th>Sector</th>

                    @if (User.IsInRole("Administrador"))
                    {
                        <th>Alerta de mora</th>
                    }

                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            @a.NIS
                        </td>

                        <td>
                            @a.NumeroPaja
                        </td>

                        <td>
                            @(a.NumeroFinca ?? "No registrado")
                        </td>

                        <td>
                            @(a.NumeroPlano ?? "No registrado")
                        </td>

                        <td>
                            @a.Direccion
                        </td>

                        <td>
                            @a.IdUsuario
                        </td>

                        <td>
                            @a.IdTarifa
                        </td>

                        <td>
                            @a.IdSector
                        </td>

                        @if (User.IsInRole("Administrador"))
                        {
                            <td class="mpa-mora"
                                data-abonado-id="@a.IdAbonado">

                                <span class="text-muted">
                                    Verificando...
                                </span>
                            </td>
                        }

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@a.IdAbonado"
                               title="Editar">

                                <i class="bi bi-pencil-square"></i>
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@a.IdAbonado"
                               class="ms-2 text-danger"
                               title="Eliminar">

                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (User.IsInRole("Administrador"))
{
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            const celdas =
                document.querySelectorAll('.mpa-mora');

            try {
                const respuesta = await fetch(
                    '@Url.Action("Morosos", "PanelAdministrativo")',
                    { credentials: 'same-origin' }
                );

                if (!respuesta.ok) {
                    throw new Error(
                        'No se pudieron consultar alertas'
                    );
                }

                const morosos = new Set(
                    (await respuesta.json()).map(Number)
                );

                celdas.forEach(celda => {
                    const id = Number(
                        celda.dataset.abonadoId
                    );

                    celda.textContent = '';

                    const etiqueta =
                        document.createElement('span');

                    etiqueta.className = morosos.has(id)
                        ? 'badge bg-warning text-dark'
                        : 'text-muted';

                    etiqueta.textContent = morosos.has(id)
                        ? 'Posible mora > 3 días (revisar)'
                        : 'Sin alerta detectada';

                    celda.appendChild(etiqueta);
                });

            } catch (error) {
                celdas.forEach(celda => {
                    celda.textContent = 'No disponible';
                });
            }
        });
    </script>
}
