@model List<Abonado>
@{ ViewData["Title"] = "Abonados"; }

<div class="panel">
    <form method="get" class="d-flex justify-content-between mb-3">
        <input type="text" name="buscar" class="form-control w-25" placeholder="Buscar abonado..." />
        <a asp-action="Create" class="btn btn-agua"><i class="bi bi-plus-lg"></i> Registrar abonado</a>
    </form>
    <table class="table table-asada mb-0">
        <thead><tr><th>Nombre</th><th>N° medidor</th><th>Dirección</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Nombre</td>
                <td>@a.NumeroMedidor</td>
                <td>@a.Direccion</td>
                <td><span class="estado @(a.Activo ? "resuelto" : "pendiente")">@(a.Activo ? "Activo" : "Suspendido")</span></td>
                <td>
                    <a asp-action="Edit" asp-route-id="@a.IdAbonado" title="Editar"><i class="bi bi-pencil-square"></i></a>
                    <a asp-action="Delete" asp-route-id="@a.IdAbonado" class="ms-2 text-danger" title="Desactivar"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
