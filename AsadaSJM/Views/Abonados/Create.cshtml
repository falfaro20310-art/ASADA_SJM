@model Abonado
@{ ViewData["Title"] = "Registrar abonado"; }

<div class="panel" style="max-width:520px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label class="form-label" asp-for="Nombre">Nombre</label>
            <input asp-for="Nombre" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Direccion">Dirección</label>
            <input asp-for="Direccion" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="NumeroMedidor">N° de medidor</label>
            <input asp-for="NumeroMedidor" class="form-control" required />
        </div>
        <div class="form-check mb-3">
            <input asp-for="Activo" class="form-check-input" checked />
            <label class="form-check-label" asp-for="Activo">Activo</label>
        </div>
        <button type="submit" class="btn btn-agua">Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
