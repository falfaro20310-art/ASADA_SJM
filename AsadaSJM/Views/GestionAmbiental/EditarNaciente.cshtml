
@model AsadaSJM.Models.Naciente

@{
    ViewData["Title"] = "Editar naciente";
}

<div class="panel">

    <h2>Editar naciente</h2>

    <p>
        Modifique la información de la naciente
        seleccionada.
    </p>

    <form asp-action="EditarNaciente"
          asp-route-id="@Model.IdNaciente"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="IdNaciente" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">

            <label asp-for="Nombre"
                   class="form-label">
                Nombre
            </label>

            <input asp-for="Nombre"
                   class="form-control"
                   maxlength="150"
                   required />

            <span asp-validation-for="Nombre"
                  class="text-danger"></span>

        </div>

        <div class="mb-3">

            <label asp-for="Ubicacion"
                   class="form-label">
                Ubicación
            </label>

            <input asp-for="Ubicacion"
                   class="form-control"
                   maxlength="250"
                   required />

            <span asp-validation-for="Ubicacion"
                  class="text-danger"></span>

        </div>

        <div class="mb-3">

            <label asp-for="Descripcion"
                   class="form-label">
                Descripción
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="5"
                      required></textarea>

            <span asp-validation-for="Descripcion"
                  class="text-danger"></span>

        </div>

        <div class="form-check mb-4">

            <input asp-for="Estado"
                   class="form-check-input" />

            <label asp-for="Estado"
                   class="form-check-label">
                Naciente activa
            </label>

        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-agua">
                Guardar cambios
            </button>

            <a asp-action="Administrar"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

        </div>

    </form>

</div>
