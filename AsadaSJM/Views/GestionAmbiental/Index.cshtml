
@using AsadaSJM.Models
@using Microsoft.EntityFrameworkCore
@inject AsadaSJM.Data.ApplicationDbContext Db

@{
    ViewData["Title"] = "Gestión Ambiental";

    // El administrador conserva el panel interno.
    // Los visitantes utilizan el portal público.
    bool vistaAdministrativa = User.IsInRole("Administrador");

    Layout = vistaAdministrativa
        ? "_Layout"
        : "_LayoutNoAuth";

    if (!vistaAdministrativa)
    {
        ViewData["BodyClass"] = "container py-4";

        if (ViewBag.InformacionContacto == null)
        {
            ViewBag.InformacionContacto =
                await Db.InformacionInstitucional
                    .AsNoTracking()
                    .OrderByDescending(i => i.IdInformacion)
                    .FirstOrDefaultAsync();
        }
    }

    var nacientes = ViewBag.Nacientes as List<Naciente>
        ?? new List<Naciente>();

    var tanques = ViewBag.Tanques as List<Tanque>
        ?? new List<Tanque>();

    var total = nacientes.Count + tanques.Count;
}

<style>
    /* ==========================================
       MGA-01 - COLORES INSTITUCIONALES ASADA
       Azul Agua: #004A99
       Verde Bosque: #2D5A27
       ========================================== */

    .ga-page {
        --ga-blue: #004A99;
        --ga-blue-dark: #003B7A;
        --ga-green: #2D5A27;
        --ga-white: #FFFFFF;
        --ga-background: #F5F7F9;
        --ga-text: #20384E;
        --ga-muted: #657584;

        font-family: 'Roboto', sans-serif;
        color: var(--ga-text);
    }

    /* ==========================================
       ENCABEZADO PRINCIPAL
       ========================================== */

    .ga-page .ga-hero {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 55px 45px;
        background: #004A99 !important;
        color: #FFFFFF !important;
        margin-bottom: 28px;
    }

    .ga-page .ga-hero::after {
        content: "◉";
        position: absolute;
        right: 35px;
        bottom: -110px;
        font-size: 300px;
        color: rgba(255,255,255,.10);
        pointer-events: none;
    }

    .ga-page .ga-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 15px;
        border-radius: 30px;
        background: rgba(255,255,255,.16);
        color: #FFFFFF !important;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .ga-page .ga-hero h2 {
        font-family: 'Montserrat', sans-serif;
        font-size: clamp(26px, 4vw, 42px);
        font-weight: 700;
        line-height: 1.2;
        max-width: 680px;
        color: #FFFFFF !important;
    }

    .ga-page .ga-hero p {
        max-width: 610px;
        color: #FFFFFF !important;
        line-height: 1.8;
        margin-top: 16px;
    }

    .ga-page .ga-manage {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: #FFFFFF;
        color: #004A99;
        border-radius: 12px;
        padding: 12px 20px;
        font-weight: 700;
        text-decoration: none;
        margin-top: 15px;
        transition: .2s;
    }

    .ga-page .ga-manage:hover {
        background: #E7F1FB;
        color: #003B7A;
    }

    /* ==========================================
       ESTADÍSTICAS
       ========================================== */

    .ga-page .ga-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 35px;
    }

    .ga-page .ga-stat {
        background: #FFFFFF;
        border: 1px solid #DEE7F0;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 4px 16px rgba(0,74,153,.04);
    }

    .ga-page .ga-stat i {
        color: #004A99;
        font-size: 24px;
    }

    .ga-page .ga-stat strong {
        display: block;
        margin-top: 10px;
        font-size: 27px;
        font-weight: 700;
        color: #004A99;
    }

    .ga-page .ga-stat span {
        font-size: 13px;
        color: #657584;
    }

    /* ==========================================
       TÍTULOS Y FILTROS
       ========================================== */

    .ga-page .ga-intro {
        margin: 32px 0 20px;
    }

    .ga-page .ga-intro h3 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 24px;
        color: #004A99;
    }

    .ga-page .ga-intro p {
        color: #657584;
    }

    .ga-page .ga-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 25px;
    }

    .ga-page .ga-tab {
        background: #FFFFFF;
        border: 1px solid #CCDCEB;
        color: #004A99;
        border-radius: 30px;
        padding: 10px 20px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

    .ga-page .ga-tab:hover,
    .ga-page .ga-tab.active {
        background: #2D5A27;
        color: #FFFFFF;
        border-color: #2D5A27;
    }

    /* ==========================================
       TARJETAS
       ========================================== */

    .ga-page .ga-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .ga-page .ga-card {
        background: #FFFFFF;
        border: 1px solid #DEE7F0;
        border-radius: 19px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0,74,153,.04);
        transition: transform .2s, box-shadow .2s;
    }

    .ga-page .ga-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(0,74,153,.12);
    }

    .ga-page .ga-card-top {
        height: 100px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* Nacientes: verde institucional */

    .ga-page .ga-naciente {
        background: #E5F0E3;
    }

    /* Tanques: azul institucional */

    .ga-page .ga-tanque {
        background: #E4F0FC;
    }

    .ga-page .ga-card-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        color: #004A99;
    }

    .ga-page .ga-naciente .ga-card-icon {
        color: #2D5A27;
    }

    .ga-page .ga-type {
        background: #FFFFFF;
        color: #20384E;
        padding: 7px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
    }

    .ga-page .ga-card-body {
        padding: 24px;
    }

    .ga-page .ga-card-body h4 {
        font-size: 21px;
        font-weight: 700;
        margin-bottom: 14px;
        color: #004A99;
    }

    .ga-page .ga-location {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #2D5A27;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .ga-page .ga-description {
        color: #657584;
        font-size: 14px;
        line-height: 1.8;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .ga-page .ga-card-footer {
        border-top: 1px solid #E5EBF1;
        padding-top: 16px;
        margin-top: 20px;
        color: #2D5A27;
        font-size: 13px;
        font-weight: 600;
    }

    /* ==========================================
       ESTADO VACÍO
       ========================================== */

    .ga-page .ga-empty {
        grid-column: 1 / -1;
        background: #F5F7F9;
        border: 1px dashed #9EBB9A;
        text-align: center;
        padding: 60px 20px;
        border-radius: 20px;
    }

    .ga-page .ga-empty i {
        font-size: 38px;
        color: #2D5A27;
    }

    .ga-page .ga-empty h4 {
        margin-top: 16px;
        font-weight: 700;
        color: #004A99;
    }

    .ga-page .ga-empty p {
        color: #657584;
    }

    /* ==========================================
       MENSAJE FINAL
       ========================================== */

    .ga-page .ga-note {
        text-align: center;
        background: #E8F2E6;
        border-radius: 16px;
        padding: 24px;
        margin-top: 40px;
        color: #2D5A27;
    }

    /* ==========================================
       MGA-02 A MGA-05 - ACCESOS AMBIENTALES
       ========================================== */

    .ga-page .ga-community {
        margin-top: 40px;
        padding: 30px;
        background: #EAF1F8;
        border: 1px solid #CCDDED;
        border-radius: 20px;
    }

    .ga-page .ga-community h3 {
        font-family: 'Montserrat', sans-serif;
        color: #004A99;
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .ga-page .ga-community p {
        color: #536D82;
        line-height: 1.7;
    }

    .ga-page .ga-community-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
        margin-top: 22px;
    }

    .ga-page .ga-community-link {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border-radius: 14px;
        background: #FFFFFF;
        border: 1px solid #DCE6EF;
        color: #004A99;
        text-decoration: none;
        transition: transform .2s, box-shadow .2s;
    }

    .ga-page .ga-community-link:hover {
        color: #004A99;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0, 74, 153, .10);
    }

    .ga-page .ga-community-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #E8F2E6;
        color: #2D5A27;
        font-size: 24px;
    }

    .ga-page .ga-community-link strong {
        display: block;
        font-size: 15px;
        margin-bottom: 3px;
    }

    .ga-page .ga-community-link small {
        display: block;
        color: #657584;
        line-height: 1.5;
    }

    /* ==========================================
       RESPONSIVE
       ========================================== */

    @@media(max-width: 768px) {
        .ga-page .ga-hero {
            padding: 35px 25px;
        }

        .ga-page .ga-stats {
            grid-template-columns: 1fr;
        }

        .ga-page .ga-grid {
            grid-template-columns: 1fr;
        }

        .ga-page .ga-community {
            padding: 22px;
        }

        .ga-page .ga-community-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ga-page">

    <!-- ENCABEZADO -->

    <section class="ga-hero">

        <div class="ga-eyebrow">
            <i class="bi bi-droplet-fill"></i>
            ASADA San José de la Montaña
        </div>

        <h2>
            Protegemos el agua
            que nos da vida.
        </h2>

        <p>
            Descubre las nacientes protegidas y los tanques
            administrados por nuestra ASADA. Cada recurso
            representa nuestro compromiso con la comunidad
            y la conservación del agua.
        </p>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-controller="GestionAmbiental"
               asp-action="Administrar"
               class="ga-manage">

                <i class="bi bi-gear-fill"></i>
                Administrar recursos

            </a>
        }

    </section>

    <!-- ESTADÍSTICAS -->

    <section class="ga-stats">

        <div class="ga-stat">
            <i class="bi bi-droplet-fill"></i>
            <strong>@nacientes.Count</strong>
            <span>Nacientes protegidas</span>
        </div>

        <div class="ga-stat">
            <i class="bi bi-water"></i>
            <strong>@tanques.Count</strong>
            <span>Tanques administrados</span>
        </div>

        <div class="ga-stat">
            <i class="bi bi-shield-check"></i>
            <strong>@total</strong>
            <span>Recursos registrados activos</span>
        </div>

    </section>

    <!-- EXPLORADOR DE RECURSOS -->

    <section>

        <div class="ga-intro">

            <h3>Explora nuestros recursos</h3>

            <p>
                Conoce su ubicación e importancia
                dentro de nuestra comunidad.
            </p>

        </div>

        <!-- FILTROS -->

        <div class="ga-tabs">

            <button type="button"
                    class="ga-tab active"
                    data-filter="todos">
                Todos (@total)
            </button>

            <button type="button"
                    class="ga-tab"
                    data-filter="naciente">
                <i class="bi bi-droplet"></i>
                Nacientes (@nacientes.Count)
            </button>

            <button type="button"
                    class="ga-tab"
                    data-filter="tanque">
                <i class="bi bi-water"></i>
                Tanques (@tanques.Count)
            </button>

        </div>

        <!-- TARJETAS -->

        <div class="ga-grid" id="gaGrid">

            @foreach (var naciente in nacientes)
            {
                <article class="ga-card"
                         data-tipo="naciente">

                    <div class="ga-card-top ga-naciente">

                        <div class="ga-card-icon">
                            <i class="bi bi-droplet-fill"></i>
                        </div>

                        <span class="ga-type">
                            Naciente protegida
                        </span>

                    </div>

                    <div class="ga-card-body">

                        <h4>@naciente.Nombre</h4>

                        <div class="ga-location">
                            <i class="bi bi-geo-alt-fill"></i>
                            @naciente.Ubicacion
                        </div>

                        <div class="ga-description">
                            @naciente.Descripcion
                        </div>

                        <div class="ga-card-footer">
                            <i class="bi bi-check-circle-fill"></i>
                            Recurso activo
                        </div>

                    </div>

                </article>
            }

            @foreach (var tanque in tanques)
            {
                <article class="ga-card"
                         data-tipo="tanque">

                    <div class="ga-card-top ga-tanque">

                        <div class="ga-card-icon">
                            <i class="bi bi-water"></i>
                        </div>

                        <span class="ga-type">
                            Tanque administrado
                        </span>

                    </div>

                    <div class="ga-card-body">

                        <h4>@tanque.Nombre</h4>

                        <div class="ga-location">
                            <i class="bi bi-geo-alt-fill"></i>
                            @tanque.Ubicacion
                        </div>

                        <div class="ga-description">
                            @tanque.Descripcion
                        </div>

                        <div class="ga-card-footer">
                            <i class="bi bi-check-circle-fill"></i>
                            Recurso activo
                        </div>

                    </div>

                </article>
            }

            <!-- MENSAJE SIN RESULTADOS -->

            <div class="ga-empty"
                 id="gaEmpty"
                 style="display:none">

                <i class="bi bi-droplet-half"></i>

                <h4>No hay recursos disponibles</h4>

                <p>
                    Todavía no se han registrado
                    recursos en esta categoría.
                </p>

            </div>

        </div>

    </section>

    <!-- ==========================================
         MGA-02 A MGA-05 - PARTICIPACIÓN AMBIENTAL
         ========================================== -->

    <section class="ga-community" aria-labelledby="gaCommunityTitle">

        <h3 id="gaCommunityTitle">
            <i class="bi bi-tree me-2"></i>
            Educación y participación ambiental
        </h3>

        <p>
            Accede al material educativo, conoce las campañas,
            participa en actividades de voluntariado y explora
            fotografías de los proyectos ambientales de la ASADA.
        </p>

        <div class="ga-community-grid">

            <!-- MGA-02 -->
            <a class="ga-community-link"
               asp-controller="ComunidadAmbiental"
               asp-action="Index"
               asp-fragment="materiales">

                <span class="ga-community-icon">
                    <i class="bi bi-file-earmark-pdf"></i>
                </span>

                <span>
                    <strong>Material educativo</strong>
                    <small>Consultar y descargar documentos PDF.</small>
                </span>

            </a>

            <!-- MGA-03 -->
            <a class="ga-community-link"
               asp-controller="ComunidadAmbiental"
               asp-action="Index"
               asp-fragment="campanas">

                <span class="ga-community-icon">
                    <i class="bi bi-calendar-event"></i>
                </span>

                <span>
                    <strong>Campañas ambientales</strong>
                    <small>Conocer las campañas registradas.</small>
                </span>

            </a>

            <!-- MGA-04 -->
            <a class="ga-community-link"
               asp-controller="ComunidadAmbiental"
               asp-action="Index"
               asp-fragment="voluntariado">

                <span class="ga-community-icon">
                    <i class="bi bi-people"></i>
                </span>

                <span>
                    <strong>Voluntariado</strong>
                    <small>Inscribirse en actividades ambientales.</small>
                </span>

            </a>

            <!-- MGA-05 -->
            <a class="ga-community-link"
               asp-controller="ComunidadAmbiental"
               asp-action="Index"
               asp-fragment="galeria-ambiental">

                <span class="ga-community-icon">
                    <i class="bi bi-images"></i>
                </span>

                <span>
                    <strong>Galería ambiental</strong>
                    <small>Ver fotografías de proyectos realizados.</small>
                </span>

            </a>

        </div>

    </section>

    <!-- MENSAJE FINAL -->

    <section class="ga-note">

        <i class="bi bi-heart-fill"></i>

        <strong>
            Cuidar el agua es cuidar nuestro futuro.
        </strong>

        <div class="mt-2">
            ASADA San José de la Montaña
        </div>

    </section>

</div>

<!-- FILTROS INTERACTIVOS -->

<script>
    (function () {
        const botones = document.querySelectorAll(".ga-tab");
        const tarjetas = document.querySelectorAll(".ga-card");
        const vacio = document.getElementById("gaEmpty");

        function filtrar(tipo) {
            let visibles = 0;

            tarjetas.forEach(function (tarjeta) {
                const mostrar =
                    tipo === "todos" ||
                    tarjeta.dataset.tipo === tipo;

                tarjeta.style.display = mostrar ? "" : "none";

                if (mostrar) {
                    visibles++;
                }
            });

            vacio.style.display =
                visibles === 0 ? "block" : "none";

            botones.forEach(function (boton) {
                boton.classList.toggle(
                    "active",
                    boton.dataset.filter === tipo
                );
            });
        }

        botones.forEach(function (boton) {
            boton.addEventListener("click", function () {
                filtrar(boton.dataset.filter);
            });
        });

        filtrar("todos");
    })();
</script>
