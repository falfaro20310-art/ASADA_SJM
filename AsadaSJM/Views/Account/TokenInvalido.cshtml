@{
    Layout = null;
    ViewData["Title"] = "Enlace no válido";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <title>
        Enlace no válido - ASADA SJM
    </title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>

<body>

    <div class="login-wrapper">

        <div class="login-card text-center">

            <div class="icon-drop">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h1 style="font-size:22px;">
                Enlace no válido
            </h1>

            <p class="text-muted mt-3"
               style="font-size:14px;">

                El enlace de recuperación no es válido,
                ya fue utilizado o ha expirado.

            </p>

            <a asp-controller="Account"
               asp-action="RecuperarContrasena"
               class="btn btn-agua w-100 mt-3">

                Solicitar otro enlace

            </a>

        </div>

    </div>

</body>

</html>