@{
    Layout = null;
    ViewData["Title"] = "Recuperar contraseña";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <title>
        Recuperar contraseña - ASADA SJM
    </title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Roboto:wght@400;500&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>

<body>

    <div class="login-wrapper">

        <div class="login-card">

            <div class="icon-drop">
                <i class="bi bi-key-fill"></i>
            </div>

            <h1 class="text-center mb-1"
                style="font-size:22px;">

                ASADA San José de la Montaña

            </h1>

            <p class="text-center text-muted mb-4"
               style="font-size:14px;">

                Recuperar contraseña

            </p>

            @if (TempData["MensajeRecuperacion"] != null)
            {
                <div class="alert alert-success"
                     style="font-size:13px;">

                    @TempData["MensajeRecuperacion"]

                </div>
            }

            <div asp-validation-summary="All"
                 class="text-danger"
                 style="font-size:13px;">
            </div>

            <form asp-action="RecuperarContrasena"
                  method="post">

                <div class="mb-3">

                    <label class="form-label">
                        Correo electrónico
                    </label>

                    <input type="email" 
                           autocomplete="off"
                           name="correo"
                           class="form-control"
                           placeholder="usuario@asadasjm.cr"
                           required />

                </div>

                <button type="submit"
                        class="btn btn-agua w-100 py-2">

                    Enviar enlace de recuperación

                </button>

            </form>

            <p class="text-center mt-3 mb-0"
               style="font-size:13px;">

                <a asp-controller="Account"
                   asp-action="Login">

                    Volver a iniciar sesión

                </a>

            </p>

        </div>

    </div>

</body>

</html>