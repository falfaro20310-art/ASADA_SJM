@model List<Averia>
@{
    ViewData["Title"] = "Inicio";
}

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="stat-card"><div class="num">@ViewBag.AbonadosActivos</div><div class="lbl">Abonados activos</div></div></div>
    <div class="col-md-3"><div class="stat-card verde"><div class="num">@ViewBag.AveriasProceso</div><div class="lbl">Averías en proceso</div></div></div>
    <div class="col-md-3"><div class="stat-card"><div class="num">@ViewBag.TramitesPendientes</div><div class="lbl">Trámites pendientes</div></div></div>
    <div class="col-md-3"><div class="stat-card verde"><div class="num">96%</div><div class="lbl">Disponibilidad del servicio</div></div></div>
</div>

<div class="panel">
    <h2 class="mb-3" style="font-size:18px;">Últimas averías reportadas</h2>
    <table class="table table-asada mb-0">
        <thead><tr><th>Caso</th><th>Abonado</th><th>Descripción</th><th>Estado</th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>#A-@a.IdAveria.ToString("000")</td>
                <td>@a.Abonado?.Nombre</td>
                <td>@a.Descripcion</td>
                <td>
                    @{ var css = a.Estado == "Pendiente" ? "pendiente" : a.Estado == "En proceso" ? "proceso" : "resuelto"; }
                    <span class="estado @css">@a.Estado</span>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
