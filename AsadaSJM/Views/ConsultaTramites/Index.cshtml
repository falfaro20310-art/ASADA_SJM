@model AsadaSJM.Models.ViewModels.ConsultaTramitesViewModel

@{
    ViewData["Title"] = "Historial de trámites";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="mb-1">
            Historial y consulta de trámites
        </h2>

        <p class="text-muted mb-0">
            Consulte un trámite específico o el historial completo
            asociado a una paja.
        </p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get"
                  asp-controller="ConsultaTramites"
                  asp-action="Index">

                <div class="row g-3 align-items-end">

                    <div class="col-md-9">
                        <label asp-for="Busqueda"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Busqueda"
                               class="form-control"
                               placeholder="Ej.: DH-2026-000004 o número de paja" />
                    </div>

                    <div class="col-md-3 d-grid">
                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-search me-1"></i>
                            Consultar
                        </button>
                    </div>

                </div>

            </form>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    <div asp-validation-summary="All"></div>
                </div>
            }

        </div>
    </div>

    @if (Model.BusquedaRealizada)
    {
        if (Model.Resultados.Count == 0)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-1"></i>
                No existen trámites asociados a ese número
                dentro de su cuenta.
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap
                        justify-content-between
                        align-items-center
                        gap-2 mb-3">

                <div>
                    <h5 class="mb-0">
                        Historial encontrado
                    </h5>

                    <small class="text-muted">
                        Los trámites se muestran del más reciente
                        al más antiguo.
                    </small>
                </div>

                <span class="badge bg-secondary">
                    @Model.Resultados.Count
                    @(Model.Resultados.Count == 1 ? "trámite" : "trámites")
                </span>

            </div>

            <div class="row g-3">

                @foreach (var tramite in Model.Resultados)
                {
                    string badge =
                        tramite.Estado switch
                        {
                            "Aprobado" => "bg-success",
                            "Rechazado" => "bg-danger",
                            "Pendiente" => "bg-warning text-dark",
                            _ => "bg-secondary"
                        };

                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-body">

                                <div class="d-flex flex-wrap
                                            justify-content-between
                                            align-items-start
                                            gap-2 mb-3">

                                    <div>
                                        <h5 class="mb-1">
                                            @tramite.NumeroTramite
                                        </h5>

                                        <div class="text-muted">
                                            @tramite.TipoTramite
                                        </div>
                                    </div>

                                    <span class="badge @badge fs-6">
                                        @tramite.Estado
                                    </span>

                                </div>

                                <div class="row g-3">

                                    <div class="col-md-4">
                                        <div class="text-muted small">
                                            Fecha de solicitud
                                        </div>

                                        <div>
                                            @tramite.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="text-muted small">
                                            Número de paja
                                        </div>

                                        <div>
                                            @(string.IsNullOrWhiteSpace(tramite.NumeroPaja)
                                                ? "No asociado"
                                                : tramite.NumeroPaja)
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="text-muted small">
                                            Fecha de finalización
                                        </div>

                                        <div>
                                            @(tramite.FechaFinalizacion.HasValue
                                                ? tramite.FechaFinalizacion.Value.ToString("dd/MM/yyyy HH:mm")
                                                : "Pendiente")
                                        </div>
                                    </div>

                                </div>

                                @if (tramite.Estado == "Rechazado" &&
                                     !string.IsNullOrWhiteSpace(
                                         tramite.MotivoRechazo))
                                {
                                    <div class="alert alert-danger mt-3 mb-0">
                                        <strong>
                                            Motivo del rechazo:
                                        </strong>
                                        @tramite.MotivoRechazo
                                    </div>
                                }

                                @if (tramite.DocumentosFinales.Count > 0)
                                {
                                    <hr class="my-3" />

                                    <div>
                                        <div class="fw-semibold mb-2">
                                            Documentos finales
                                        </div>

                                        <div class="d-flex flex-wrap gap-2">

                                            @foreach (var documento in tramite.DocumentosFinales)
                                            {
                                                <a class="btn btn-outline-primary btn-sm"
                                                   asp-controller="ConsultaTramites"
                                                   asp-action="DescargarDocumentoFinal"
                                                   asp-route-id="@documento.IdDocumento">
                                                    <i class="bi bi-file-earmark-pdf me-1"></i>
                                                    Descargar constancia
                                                </a>
                                            }

                                        </div>
                                    </div>
                                }
                                else if (tramite.Estado == "Aprobado")
                                {
                                    <div class="text-muted small mt-3">
                                        No hay documentos finales disponibles
                                        para este trámite.
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                }

            </div>
        }
    }

</div>
