@model List<AsadaSJM.Models.ReciboPendienteViewModel>

@{
    ViewData["Title"] = "Recibos pendientes";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Recibos pendientes | ASADA SJM</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/oficina-virtual.css" />
</head>
<body>
    <main class="container py-4">
        <a asp-controller="OficinaVirtual" asp-action="Index"
           class="btn btn-outline-secondary mb-3">
            <i class="bi bi-arrow-left"></i> Volver a la Oficina Virtual
        </a>

        <h1 class="h3 mb-2">Recibos pendientes</h1>
        <p class="text-muted">Consulta los recibos pendientes o vencidos de tu servicio.</p>

        @if (Model.Count == 0)
        {
            <div class="alert alert-success">
                No tienes recibos pendientes registrados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Período</th>
                            <th>NIS</th>
                            <th>Vencimiento</th>
                            <th>Monto pendiente</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var recibo in Model)
                        {
                            <tr>
                                <td>@recibo.Periodo</td>
                                <td>@recibo.NIS</td>
                                <td>@recibo.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td>@recibo.Monto.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-CR"))</td>
                                <td>
                                    <span class="badge @(recibo.Estado.Equals("Vencido", StringComparison.OrdinalIgnoreCase) ? "bg-danger" : "bg-warning text-dark")">
                                        @recibo.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </main>
</body>
</html>

