@model AsadaSJM.Models.OficinaVirtualViewModel

@{
    Layout = null;
    ViewData["Title"] = "Oficina Virtual";

    var nombre = string.IsNullOrWhiteSpace(Model.NombreCompleto)
        ? "Abonado"
        : Model.NombreCompleto;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Oficina Virtual | ASADA SJM</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/oficina-virtual.css" />
</head>

<body>
    <div class="dashboard">

        <!-- MENÚ LATERAL -->
        <aside class="sidebar" id="sidebar">

            <a class="brand"
               asp-controller="OficinaVirtual"
               asp-action="Index">
                <span class="brand-icon">
                    <i class="bi bi-droplet-fill"></i>
                </span>

                <span class="brand-text">
                    <strong>ASADA SJM</strong>
                    <small>San José de la Montaña</small>
                </span>
            </a>

            <nav class="side-navigation">

                <a class="side-link active"
                   asp-controller="OficinaVirtual"
                   asp-action="Index">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Inicio</span>
                </a>

                <div class="side-section">MI SERVICIO</div>

                <a class="side-link"
                   asp-controller="OficinaVirtual"
                   asp-action="MisRecibos">
                    <i class="bi bi-receipt"></i>
                    <span>Mis recibos</span>
                </a>

                <a class="side-link"
                   asp-controller="OficinaVirtual"
                   asp-action="RecibosPendientes">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>Recibos pendientes</span>
                </a>

                <a class="side-link"
                   asp-controller="OficinaVirtual"
                   asp-action="MiConsumo">
                    <i class="bi bi-bar-chart-line"></i>
                    <span>Mi consumo</span>
                </a>

                <a class="side-link"
                   asp-controller="OficinaVirtual"
                   asp-action="MisPagos">
                    <i class="bi bi-credit-card"></i>
                    <span>Mis pagos</span>
                </a>

                <a class="side-link"
                   asp-controller="OficinaVirtual"
                   asp-action="CanalesPago">
                    <i class="bi bi-wallet2"></i>
                    <span>Canales de pago</span>
                </a>

                <div class="side-section">SOLICITUDES</div>

                <a class="side-link"
                   asp-controller="OficinaVirtual"
                   asp-action="MisTramites">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Mis trámites</span>
                </a>

                <a class="side-link"
                   asp-controller="OficinaVirtual"
                   asp-action="MisAverias">
                    <i class="bi bi-tools"></i>
                    <span>Mis averías</span>
                </a>

                <div class="side-section">INSTITUCIONAL</div>

                <a class="side-link"
                   asp-controller="Portal"
                   asp-action="Index">
                    <i class="bi bi-globe2"></i>
                    <span>Portal institucional</span>
                </a>

                <a class="side-link"
                   asp-controller="GestionAmbiental"
                   asp-action="Index">
                    <i class="bi bi-tree"></i>
                    <span>Gestión ambiental</span>
                </a>

            </nav>

            <div class="sidebar-bottom">
                <div class="water-symbol">
                    <i class="bi bi-droplet-half"></i>
                </div>
                <p>Cuidamos el agua,<br />protegemos la vida.</p>
            </div>

        </aside>

        <!-- ÁREA PRINCIPAL -->
        <div class="main-area">

            <!-- BARRA SUPERIOR -->
            <header class="topbar">

                <button type="button"
                        class="menu-toggle"
                        id="menuToggle"
                        aria-label="Abrir o cerrar menú">
                    <i class="bi bi-list"></i>
                </button>

                <div class="topbar-right">

                    <div class="topbar-user-icon">
                        <i class="bi bi-person-circle"></i>
                    </div>

                    <span class="topbar-name">@nombre</span>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="logout-button">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Cerrar sesión</span>
                        </button>
                    </form>

                </div>

            </header>

            <!-- CONTENIDO -->
            <main class="content-area">

                <!-- ENCABEZADO -->
                <section class="welcome-section">

                    <div class="welcome-text">
                        <div class="breadcrumb-custom">
                            <span>Inicio</span>
                            <i class="bi bi-chevron-right"></i>
                            <span>Servicios</span>
                            <i class="bi bi-chevron-right"></i>
                            <strong>Oficina Virtual</strong>
                        </div>

                        <h1>¡Bienvenido(a), @nombre!</h1>

                        <p>
                            Consulta la información de tu servicio,
                            revisa tus recibos y accede a los servicios
                            digitales de la ASADA.
                        </p>
                    </div>

                    <!-- IDENTIFICACIÓN DEL SERVICIO -->
                    <div class="nis-card">
                        <div class="nis-label">
                            NIS (Número de Identificación de Servicio)
                        </div>

                        <div class="nis-value">
                            @(string.IsNullOrWhiteSpace(Model.NIS)
                                ? "No disponible"
                                : Model.NIS)
                        </div>

                        <div class="nis-detail">
                            <span>Abonado:</span>
                            <strong>@nombre</strong>
                        </div>

                        <div class="nis-detail">
                            <span>Sector:</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Sector)
                                    ? "No disponible"
                                    : Model.Sector)
                            </strong>
                        </div>
                    </div>

                </section>

                <!-- TARJETAS DE ACCESO -->
                <section class="summary-grid">

                    <article class="summary-card">
                        <div class="summary-top">
                            <div class="summary-icon icon-blue">
                                <i class="bi bi-receipt"></i>
                            </div>
                            <div>
                                <span class="summary-title">Mis recibos</span>
                                <h3>Consulta de recibos</h3>
                                <p>Revisa los recibos de tu servicio.</p>
                            </div>
                        </div>

                        <a asp-controller="OficinaVirtual"
                           asp-action="MisRecibos"
                           class="summary-link">
                            Consultar recibos
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </article>

                    <article class="summary-card">
                        <div class="summary-top">
                            <div class="summary-icon icon-green">
                                <i class="bi bi-bar-chart-line-fill"></i>
                            </div>
                            <div>
                                <span class="summary-title">Consumo de agua</span>
                                <h3>Mi consumo</h3>
                                <p>Consulta tu historial de consumo.</p>
                            </div>
                        </div>

                        <a asp-controller="OficinaVirtual"
                           asp-action="MiConsumo"
                           class="summary-link">
                            Ver historial
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </article>

                    <article class="summary-card">
                        <div class="summary-top">
                            <div class="summary-icon icon-purple">
                                <i class="bi bi-credit-card-2-front-fill"></i>
                            </div>
                            <div>
                                <span class="summary-title">Pagos realizados</span>
                                <h3>Mis pagos</h3>
                                <p>Revisa tu historial de pagos.</p>
                            </div>
                        </div>

                        <a asp-controller="OficinaVirtual"
                           asp-action="MisPagos"
                           class="summary-link">
                            Ver pagos
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </article>

                    <article class="summary-card">
                        <div class="summary-top">
                            <div class="summary-icon icon-orange">
                                <i class="bi bi-exclamation-circle-fill"></i>
                            </div>
                            <div>
                                <span class="summary-title">Estado de cuenta</span>
                                <h3>Recibos pendientes</h3>
                                <p>Consulta tus obligaciones pendientes.</p>
                            </div>
                        </div>

                        <a asp-controller="OficinaVirtual"
                           asp-action="RecibosPendientes"
                           class="summary-link">
                            Ver pendientes
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </article>

                </section>

                <!-- INFORMACIÓN DEL SERVICIO -->
                <section class="panel service-panel">

                    <div class="panel-heading">
                        <div>
                            <span class="eyebrow">INFORMACIÓN PERSONAL</span>
                            <h2>Información de mi servicio</h2>
                            <p>Datos asociados a tu servicio de agua potable.</p>
                        </div>

                        <div class="heading-icon">
                            <i class="bi bi-person-vcard"></i>
                        </div>
                    </div>

                    <div class="service-grid">

                        <div class="service-item">
                            <span>NIS</span>
                            <strong>@Model.NIS</strong>
                        </div>

                        <div class="service-item">
                            <span>Número de paja</span>
                            <strong>@Model.NumeroPaja</strong>
                        </div>

                        <div class="service-item">
                            <span>Tarifa</span>
                            <strong>@Model.Tarifa</strong>
                        </div>

                        <div class="service-item">
                            <span>Sector</span>
                            <strong>@Model.Sector</strong>
                        </div>

                        <div class="service-item">
                            <span>Número de finca</span>
                            <strong>@Model.NumeroFinca</strong>
                        </div>

                        <div class="service-item">
                            <span>Número de plano</span>
                            <strong>@Model.NumeroPlano</strong>
                        </div>

                        <div class="service-item">
                            <span>Teléfono</span>
                            <strong>@Model.Telefono</strong>
                        </div>

                        <div class="service-item">
                            <span>Correo electrónico</span>
                            <strong>@Model.Correo</strong>
                        </div>

                        <div class="service-item service-address">
                            <span>Dirección</span>
                            <strong>@Model.Direccion</strong>
                        </div>

                    </div>

                </section>

                <!-- ACCESOS Y SERVICIOS -->
                <section class="lower-grid">

                    <div class="panel services-panel">
                        <div class="panel-heading">
                            <div>
                                <span class="eyebrow">GESTIONES DIGITALES</span>
                                <h2>Servicios disponibles</h2>
                            </div>
                        </div>

                        <div class="service-shortcuts">

                            <a asp-controller="OficinaVirtual"
                               asp-action="MisTramites"
                               class="shortcut">
                                <span class="shortcut-icon icon-blue">
                                    <i class="bi bi-file-earmark-text"></i>
                                </span>
                                <span class="shortcut-copy">
                                    <strong>Mis trámites</strong>
                                    <small>Consulta y seguimiento de solicitudes</small>
                                </span>
                                <i class="bi bi-chevron-right shortcut-arrow"></i>
                            </a>

                            <a asp-controller="OficinaVirtual"
                               asp-action="MisAverias"
                               class="shortcut">
                                <span class="shortcut-icon icon-orange">
                                    <i class="bi bi-tools"></i>
                                </span>
                                <span class="shortcut-copy">
                                    <strong>Mis averías</strong>
                                    <small>Consulta tus reportes</small>
                                </span>
                                <i class="bi bi-chevron-right shortcut-arrow"></i>
                            </a>

                            <a asp-controller="OficinaVirtual"
                               asp-action="CanalesPago"
                               class="shortcut">
                                <span class="shortcut-icon icon-green">
                                    <i class="bi bi-wallet2"></i>
                                </span>
                                <span class="shortcut-copy">
                                    <strong>Canales de pago</strong>
                                    <small>Consulta las opciones disponibles</small>
                                </span>
                                <i class="bi bi-chevron-right shortcut-arrow"></i>
                            </a>

                            <a asp-controller="Portal"
                               asp-action="Index"
                               class="shortcut">
                                <span class="shortcut-icon icon-purple">
                                    <i class="bi bi-globe2"></i>
                                </span>
                                <span class="shortcut-copy">
                                    <strong>Portal institucional</strong>
                                    <small>Información de nuestra ASADA</small>
                                </span>
                                <i class="bi bi-chevron-right shortcut-arrow"></i>
                            </a>

                            <a asp-controller="GestionAmbiental"
                               asp-action="Index"
                               class="shortcut">
                                <span class="shortcut-icon icon-green">
                                    <i class="bi bi-tree"></i>
                                </span>
                                <span class="shortcut-copy">
                                    <strong>Gestión ambiental</strong>
                                    <small>Conoce los recursos protegidos</small>
                                </span>
                                <i class="bi bi-chevron-right shortcut-arrow"></i>
                            </a>

                        </div>
                    </div>

                    <!-- PANEL DE PAGO -->
                    <aside class="payment-column">

                        <div class="payment-panel">
                            <div class="payment-illustration">
                                <i class="bi bi-credit-card-2-front"></i>
                                <span>
                                    <i class="bi bi-shield-check"></i>
                                </span>
                            </div>

                            <h2>Consulta tus pagos</h2>

                            <p>
                                Accede a tus recibos y consulta las
                                opciones de pago disponibles.
                            </p>

                            <a asp-controller="OficinaVirtual"
                               asp-action="CanalesPago"
                               class="primary-button">
                                <i class="bi bi-wallet2"></i>
                                Ver canales de pago
                            </a>

                            <a asp-controller="OficinaVirtual"
                               asp-action="MisPagos"
                               class="secondary-button">
                                Consultar historial de pagos
                            </a>
                        </div>

                        <div class="help-panel">
                            <div class="help-icon">
                                <i class="bi bi-info-circle"></i>
                            </div>
                            <div>
                                <strong>¿Necesitas ayuda?</strong>
                                <p>
                                    Consulta el portal institucional
                                    para obtener información de la ASADA.
                                </p>
                                <a asp-controller="Portal"
                                   asp-action="Index">
                                    Ir al portal
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>

                    </aside>

                </section>

                <!-- PIE DE PÁGINA -->
                <footer class="dashboard-footer">
                    <span>
                        © @DateTime.Now.Year ASADA San José de la Montaña.
                        Todos los derechos reservados.
                    </span>
                    <span>
                        <i class="bi bi-droplet-fill"></i>
                        Cuidamos el agua, protegemos la vida.
                    </span>
                </footer>

            </main>
        </div>
    </div>

    <script>
            const menuToggle = document.getElementById("menuToggle");
            const sidebar = document.getElementById("sidebar");

            menuToggle.addEventListener("click", function () {
                sidebar.classList.toggle("sidebar-open");
            });

            document.addEventListener("click", function (event) {
                const isMobile = window.matchMedia("(max-width: 900px)").matches;

                if (
                    isMobile &&
                    !sidebar.contains(event.target) &&
                    !menuToggle.contains(event.target)
                ) {
                    sidebar.classList.remove("sidebar-open");
                }
            });
    </script>

</body>
</html>

