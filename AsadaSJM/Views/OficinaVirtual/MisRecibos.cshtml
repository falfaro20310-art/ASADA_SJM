@model List<AsadaSJM.Models.ReciboAbonadoViewModel>

@{
    ViewData["Title"] = "Mis recibos";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mis recibos | ASADA SJM</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/oficina-virtual.css" />
</head>
<body>
    <main class="container py-4">
        <a asp-controller="OficinaVirtual" asp-action="Index"
           class="btn btn-outline-secondary mb-3">
            <i class="bi bi-arrow-left"></i> Volver a la Oficina Virtual
        </a>

        <h1 class="h3 mb-2">Mis recibos</h1>
        <p class="text-muted">Recibos asociados a tu servicio de agua.</p>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">
                No hay recibos registrados para tu servicio.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Período</th>
                            <th>Fecha de emisión</th>
                            <th>Fecha de vencimiento</th>
                            <th>Monto</th>
                            <th>Estado</th>
                            <th>Documento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var recibo in Model)
                        {
                            <tr>
                                <td>@recibo.Periodo</td>
                                <td>@recibo.FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td>@recibo.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td>@recibo.Monto.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-CR"))</td>
                                <td>
                                    <span class="badge @(recibo.Estado.Equals("Pendiente", StringComparison.OrdinalIgnoreCase) ? "bg-warning text-dark" : "bg-secondary")">
                                        @recibo.Estado
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(recibo.RutaPDF))
                                    {
                                        <a asp-controller="OficinaVirtual"
                                           asp-action="DescargarRecibo"
                                           asp-route-id="@recibo.IdRecibo"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-file-earmark-pdf"></i> Descargar
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin PDF</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </main>
</body>
</html>
