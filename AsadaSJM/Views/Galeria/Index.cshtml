@model IEnumerable<AsadaSJM.Models.GaleriaDTO>

@{
    bool isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador");

    Layout = isAdmin ? "~/Views/Shared/_Layout.cshtml" : "~/Views/Shared/_LayoutNoAuth.cshtml";

    ViewData["Title"] = "Galería Fotográfica";

    ViewData["BodyClass"] = "body_gallery";
}

<div class="@(isAdmin ? "container py-5 min-vh-100" : "container py-5 min-vh-100")">

    @if (!isAdmin)
    {
        <h2 class="fw-semibold mb-3 col-12">@ViewData["Title"]</h2>
    }
    
    <div class="d-flex justify-content-between align-items-center mb-4">

        @if (isAdmin)
        {
            <a asp-action="Crear" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Nueva Galería
            </a>
        }
    </div>

    <partial name="_GaleriaCardsPartial" model="Model" />

</div>

@* Modal *@
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="exampleModalLabel">Colección Fotográfica</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
            </div>
        </div>
    </div>
</div>
@*
@section scripts {
    <script src="~/js/FotoGaleriaScript.js"></script>
} *@
